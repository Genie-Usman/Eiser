{% comment %} 
                                                                                                      SlashCart Megamenu
                                                                                                        A pixel-perfect replica of the SlashCart design with: 
                                                                                                      -   Announcement bar with 3-column layout 
                                                                                                       -  Main header with logo, navigation, and CTAs 
                                                                                                       -  Dropdown megamenus with image-based menu items 
                                                                                                       -  Optional CTA section per dropdown 
                                                                                                        - Mobile responsive navigation 
{% endcomment %}

<style>
  /* SlashCart Megamenu Styles */
  .slashcart-megamenu {
    --primary-green: {{ section.settings.primary_color }};
    --dark-bg: {{ section.settings.announcement_bg }};
    --header-bg: {{ section.settings.header_bg }};
    --text-dark: {{ section.settings.text_color }};
  }

  [x-cloak] {
    display: none !important;
  }

  /* Dropdown animation */
  .slashcart-dropdown {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease-out;
  }

  .slashcart-nav-item:hover .slashcart-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Mobile accordion animation */
  .slashcart-mobile-accordion {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out;
  }

  .slashcart-mobile-accordion[data-open="true"] {
    max-height: 2000px;
  }

  .slashcart-mobile-accordion-content {
  ;
  /* Nothing needed here */
}

/* Mobile drawer */
.slashcart-mobile-overlay {
  transition: opacity 0.3s ease-out;
}

.slashcart-mobile-drawer {
  transition: transform 0.3s ease-out;
}

/* Dropdown item hover styles */
.slashcart-dropdown-item {
  transition: all 0.2s ease-out;
  border-radius: 2px;
  position: relative;
  /* Needed for absolute positioning of pseudo-element */
}

.slashcart-dropdown-item::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 5px;
  height: 60px;
  /* Refined height */
  background-color: #000000;
  border-radius: 2px;
  opacity: 0;
  transition: opacity 0.2s ease-out;
}

.slashcart-dropdown-item:hover {
  background-color: #ecf3ff;
  /* Light blueish tint like reference */
}

.slashcart-dropdown-item:hover::before {
  opacity: 1;
}

/* Mobile Tree View Styles */
.slashcart-mobile-tree-container {
  padding-left: 2rem;
  position: relative;
}

/* The main vertical line trunk */
.slashcart-mobile-tree-container::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 2rem;
  /* Stop before the very bottom to look clean */
  left: 1.5rem;
  /* Align with the parent toggle or indention */
  width: 2px;
  background-color: #d1d5db;
  /* Gray-300 matching branches */
}

/* The container for an individual item */
.slashcart-mobile-tree-item {
  position: relative;
  padding-left: 1.5rem;
  /* Space for the connector */
  margin-bottom: 1.5rem;
  /* Spacing between items */
}

/* The horizontal connector line */
.slashcart-mobile-tree-item::before {
  content: '';
  position: absolute;
  top: 1.75rem;
  /* Center vertically relative to icon/text top area (28px = 8px padding + 20px half-icon) */
  left: -0.5rem;
  /* specific to connect with the trunk */
  width: 2rem;
  height: 1px;
  /* Thinner line for elegance */
  background-color: #d1d5db;
  /* Gray-300 lighter */
}

/* Curve connector attempt (optional, straight L is fine usually) */
.slashcart-mobile-tree-item::after {
;
/* Can add a dot or curve if needed, sticking to lines for now */
}
</style>

<div class="slashcart-megamenu" x-data="{ mobileOpen: false }">

  {% comment %} ===== ANNOUNCEMENT BAR ===== {% endcomment %}
  {% if section.settings.show_announcement %}
    <div class="w-full py-2.5 px-4" style="background-color: {{ section.settings.announcement_bg }};">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 text-xs md:text-sm" style="color: {{ section.settings.announcement_text }};">

        <!-- Left: Find Us On Shopify -->
        <div class="flex items-center gap-2">
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor">
            <path d="M15.337 23.979l7.216-1.561s-2.604-17.613-2.625-17.745c-.021-.128-.145-.207-.271-.194l-1.962.167c-.168-.52-.462-1-.865-1.391-.711-.69-1.61-1.04-2.626-1.04-.165 0-.335.01-.508.029-.247-.315-.544-.56-.893-.734-.77-.383-1.72-.469-2.682-.24-2.023.479-3.94 2.376-5.182 5.093-.87 1.907-1.363 4.257-1.154 6.084.088.767.304 1.406.644 1.906.602.884 1.569 1.293 2.708 1.184.863-.082 1.8-.438 2.705-1.011-.06.52-.092 1.061-.094 1.618v.04l-.004 7.796h5.593z" />
          </svg>
          <span>{{ section.settings.announcement_left }}</span>
        </div>

        <!-- Center: Award Text -->
        <div class="hidden md:flex items-center gap-2">
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          <span>{{ section.settings.announcement_center }}</span>
        </div>

        <!-- Right: Reviews -->
        <div class="flex items-center gap-2">
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
          </svg>
          <span>{{ section.settings.announcement_right }}</span>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} ===== MAIN HEADER ===== {% endcomment %}
  <header class="w-full py-3 px-6 shadow-sm" style="background-color: {{ section.settings.header_bg }};">
    <div class="mx-auto flex items-center justify-between gap-6 relative" style="max-width: 1280px;">

      <!-- Mobile Menu Button (LEFT on mobile) -->
      <button
        @click="mobileOpen = true"
        class="lg:hidden p-2 order-first z-10 relative"
        aria-label="Open menu">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          style="color: {{ section.settings.text_color }};">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Logo (CENTER on mobile, LEFT on desktop) -->
      <a href="{{ routes.root_url }}" class="shrink-0 lg:order-first absolute left-1/2 -translate-x-1/2 lg:static lg:translate-x-0">
        {% if section.settings.logo %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            class="h-auto"
            height="inherit"
            width="inherit"
            style="width: {{ section.settings.logo_width }}px;"
            loading="eager">
        {% else %}
          <span class="text-2xl font-bold" style="color: {{ section.settings.text_color }};">{{ shop.name }}</span>
        {% endif %}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6">
        {% for link in linklists[section.settings.main_menu].links %}
          {% comment %} Check for custom blocks (dropdown_item or menu_group) {% endcomment %}
          {% assign has_custom_blocks = false %}
          {% assign link_title_lower = link.title | downcase | strip %}
          {% for block in section.blocks %}
            {% assign block_parent = block.settings.parent_menu | downcase | strip %}
            {% if block_parent == link_title_lower %}
              {% if block.type == 'dropdown_item' or block.type == 'menu_group' %}
                {% assign has_custom_blocks = true %}
                {% break %}
              {% endif %}
            {% endif %}
        {% endfor %}

          {% comment %} Check for native Shopify child links {% endcomment %}
          {% assign has_child_links = false %}
          {% if link.links.size > 0 %}
            {% assign has_child_links = true %}
        {% endif %}

          {% comment %} Show dropdown if either custom blocks OR native child links exist {% endcomment %}
          {% assign has_dropdown = false %}
          {% if has_custom_blocks or has_child_links %}
            {% assign has_dropdown = true %}
          {% endif %}

          <div class="slashcart-nav-item relative group">
            <a
              href="{{ link.url }}"
              class="px-3 py-2 text-base font-medium transition-colors duration-200 hover:opacity-70"
              style="color: {{ section.settings.text_color }};"
              {% if has_dropdown %}
              onclick="event.preventDefault();"
              {% endif %}>
              {{ link.title }}
            </a>

            {% comment %} ===== DROPDOWN MENU ===== {% endcomment %}
            {% if has_dropdown %}
              <div class="slashcart-dropdown absolute left-0 top-full pt-4 z-50">
                <div class="bg-white shadow-2xl border border-gray-100 pr-6 py-6 min-w-[650px]">

                  <!-- Menu Items Grid -->
                  <div class="grid grid-cols-2 gap-4">
                    {% comment %} First, show custom blocks if any {% endcomment %}
                    {% if has_custom_blocks %}
                      {% for block in section.blocks %}
                        {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                          {% if block_parent == link_title_lower %}
                          {% comment %} Render dropdown_item blocks {% endcomment %}
                          {% if block.type == 'dropdown_item' %}
                            <a
                              href="{{ block.settings.item_url | default: '#' }}"
                              class="slashcart-dropdown-item flex items-center gap-5 pl-9 pr-4 group/item"
                              {{ block.shopify_attributes }}>
                              {% if block.settings.item_image %}
                                <div class="w-14 h-14 shrink-0 overflow-hidden flex items-center justify-center">
                                  <img
                                    src="{{ block.settings.item_image | image_url: width: 100, height: 100, crop: 'center' }}"
                                    alt="{{ block.settings.item_title }}"
                                    class="w-full h-full object-contain"
                                    width="56"
                                    height="56"
                                    loading="lazy">
                                </div>
                              {% else %}
                                <div class="w-14 h-14 shrink-0 flex items-center justify-center">
                                  <svg
                                    class="w-8 h-8 text-gray-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M13 10V3L4 14h7v7l9-11h-7z" />
                                  </svg>
                                </div>
                              {% endif %}
                              <div class="flex flex-col justify-center">
                                <span class="text-sm text-gray-800 group-hover/item:text-gray-900">
                                  {% if block.settings.item_bold_text != blank %}
                                    {% assign bold_replacement = '<strong class="font-semibold">' | append: block.settings.item_bold_text | append: '</strong>' %}
                                    {{ block.settings.item_title | replace: block.settings.item_bold_text, bold_replacement }}
                                  {% else %}
                                    {{ block.settings.item_title }}
                                  {% endif %}
                                </span>
                                {% if block.settings.item_subtitle != blank %}
                                  <span class="text-xs text-gray-500">{{ block.settings.item_subtitle }}</span>
                                {% endif %}
                              </div>
                            </a>
                          {% endif %}

                          {% comment %} Render menu_group block items {% endcomment %}
                          {% if block.type == 'menu_group' %}
                            {% for i in (1..8) %}
                              {% assign title_key = 'item' | append: i | append: '_title' %}
                              {% assign title = block.settings[title_key] %}
                              {% if title != blank %}
                                {% assign image_key = 'item' | append: i | append: '_image' %}
                                {% assign bold_key = 'item' | append: i | append: '_bold' %}
                                {% assign subtitle_key = 'item' | append: i | append: '_subtitle' %}
                                {% assign url_key = 'item' | append: i | append: '_url' %}
                                <a
                                  href="{{ block.settings[url_key] | default: '#' }}"
                                  class="slashcart-dropdown-item flex items-center gap-5 py-3 pl-9 pr-4 group/item"
                                  {{ block.shopify_attributes }}>
                                  {% if block.settings[image_key] %}
                                    <div class="w-14 h-14 shrink-0 overflow-hidden flex items-center justify-center">
                                      <img
                                        src="{{ block.settings[image_key] | image_url: width: 100, height: 100, crop: 'center' }}"
                                        alt="{{ title }}"
                                        class="w-full h-full object-contain"
                                        width="56"
                                        height="56"
                                        loading="lazy">
                                    </div>
                                  {% else %}
                                    <div class="w-14 h-14 shrink-0 flex items-center justify-center">
                                      <svg
                                        class="w-8 h-8 text-gray-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M13 10V3L4 14h7v7l9-11h-7z" />
                                      </svg>
                                    </div>
                                  {% endif %}
                                  <div class="flex flex-col justify-center">
                                    <span class="text-sm text-gray-800 group-hover/item:text-gray-900">
                                      {% if block.settings[bold_key] != blank %}
                                        {% assign bold_replacement = '<strong class="font-semibold">' | append: block.settings[bold_key] | append: '</strong>' %}
                                        {{ title | replace: block.settings[bold_key], bold_replacement }}
                                      {% else %}
                                        {{ title }}
                                      {% endif %}
                                    </span>
                                    {% if block.settings[subtitle_key] != blank %}
                                      <span class="text-xs text-gray-500">{{ block.settings[subtitle_key] }}</span>
                                    {% endif %}
                                  </div>
                                </a>
                              {% endif %}
                            {% endfor %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    {% endif %}

                    {% comment %} Then, show native Shopify child links if no custom blocks {% endcomment %}
                    {% if has_child_links and has_custom_blocks == false %}
                      {% for child in link.links %}
                        <a href="{{ child.url }}" class="slashcart-dropdown-item flex items-center gap-5 py-3 pl-9 pr-4 group/item">
                          <div class="w-14 h-14 shrink-0 flex items-center justify-center">
                            <svg
                              class="w-8 h-8 text-gray-400"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24">
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                          </div>
                          <span class="text-sm text-gray-800 group-hover/item:text-gray-900">
                            {{ child.title }}
                          </span>
                        </a>
                      {% endfor %}
                    {% endif %}
                  </div>

                  <!-- Optional CTA Section -->
                  {% for block in section.blocks %}
                    {% if block.type == 'dropdown_cta' %}
                      {% assign cta_parent = block.settings.parent_menu | downcase | strip %}
                      {% assign link_title = link.title | downcase | strip %}
                      {% if cta_parent == link_title %}
                        <div class="mt-6 pt-6 border-t pl-6 border-gray-100 flex items-center justify-between gap-4" {{ block.shopify_attributes }}>
                          <div>
                            <p class="text-sm font-semibold text-gray-900">{{ block.settings.cta_title }}</p>
                            <p class="text-xs text-gray-500 mt-0.5">{{ block.settings.cta_subtitle }}</p>
                          </div>
                          <a href="{{ block.settings.cta_url | default: '#' }}" class="inline-flex items-center gap-4 px-8 py-5 text-base font-medium text-white bg-[#3D9953] hover:bg-transparent hover:text-[#3D9953] border-[#3D9953] border rounded-xs transition-all duration-200 hover:opacity-90">
                            {{ block.settings.cta_button_text }}
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              viewBox="0 0 24 24">
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                          </a>
                        </div>
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center gap-5">
        {% if section.settings.cta1_text != blank %}
          <a href="{{ section.settings.cta1_url | default: '#' }}" class="px-8 py-2.5 text-sm font-medium bg-[#37964d] hover:bg-transparent text-white hover:text-[#37964d] border-[#37964d] border transition-all duration-200 hover:opacity-90">
            {{ section.settings.cta1_text }}
          </a>
        {% endif %}

        {% if section.settings.cta2_text != blank %}
          <a href="{{ section.settings.cta2_url | default: '#' }}" class="px-8 py-2.5 text-sm font-medium bg-[#37964d] hover:bg-transparent text-white hover:text-[#37964d] border-[#37964d] border transition-all duration-200 hover:opacity-90">
            {{ section.settings.cta2_text }}
          </a>
        {% endif %}
      </div>

      <!-- Empty spacer for mobile layout balance -->
      <div class="lg:hidden w-10"></div>
    </div>
  </header>

  {% comment %} ===== MOBILE NAVIGATION ===== {% endcomment %}
  <!-- Overlay -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="mobileOpen = false"
    class="slashcart-mobile-overlay fixed inset-0 bg-black/50 z-9998"
    x-cloak></div>

  <!-- Drawer -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    @keydown.escape.window="mobileOpen = false"
    class="slashcart-mobile-drawer fixed left-0 top-0 h-full w-full bg-white z-9999 overflow-y-auto"
    x-cloak>
    <!-- Drawer Header -->
    <div class="relative flex items-center justify-center p-4 border-b border-gray-100">
      <!-- Close button on LEFT -->
      <button
        @click="mobileOpen = false"
        class="absolute left-4 p-2 text-gray-500 hover:text-gray-700"
        aria-label="Close menu">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Logo CENTERED -->
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          class="h-auto"
          height="inherit"
          width="inherit"
          style="width: {{ section.settings.logo_width | times: 0.8 }}px;">
      {% else %}
        <span class="text-xl font-bold" style="color: {{ section.settings.text_color }};">{{ shop.name }}</span>
      {% endif %}
    </div>


    <!-- Mobile Menu Items -->
    <div class="py-4">
      {% for link in linklists[section.settings.main_menu].links %}
        {% comment %} Check for custom blocks (dropdown_item or menu_group) {% endcomment %}
        {% assign has_custom_blocks = false %}
        {% assign link_title_lower = link.title | downcase | strip %}
        {% for block in section.blocks %}
          {% assign block_parent = block.settings.parent_menu | downcase | strip %}
          {% if block_parent == link_title_lower %}
            {% if block.type == 'dropdown_item' or block.type == 'menu_group' %}
              {% assign has_custom_blocks = true %}
              {% break %}
            {% endif %}
          {% endif %}
      {% endfor %}

        {% comment %} Check for native Shopify child links {% endcomment %}
        {% assign has_child_links = false %}
        {% if link.links.size > 0 %}
          {% assign has_child_links = true %}
      {% endif %}

        {% comment %} Show dropdown if either custom blocks OR native child links exist {% endcomment %}
        {% assign has_dropdown = false %}
        {% if has_custom_blocks or has_child_links %}
          {% assign has_dropdown = true %}
        {% endif %}

        {% if has_dropdown %}
          <div x-data="{ open: false }">
            <button @click="open = !open" class="w-full flex items-center justify-between px-5 py-3 text-left hover:bg-gray-50 transition-colors duration-200">
              <span class="text-base font-medium text-gray-800">{{ link.title }}</span>
              <svg
                class="w-4 h-4 text-gray-400 transition-transform duration-200"
                :class="{ 'rotate-180': open }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Content -->
            <div class="slashcart-mobile-accordion" :data-open="open">
              <div class="slashcart-mobile-accordion-content bg-white py-2 slashcart-mobile-tree-container">
                {% comment %} Show custom blocks if any {% endcomment %}
                {% if has_custom_blocks %}
                  {% for block in section.blocks %}
                    {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                      {% if block_parent == link_title_lower %}
                      {% comment %} Render dropdown_item blocks {% endcomment %}
                      {% if block.type == 'dropdown_item' %}
                        <div class="slashcart-mobile-tree-item">
                          <a href="{{ block.settings.item_url | default: '#' }}" class="flex items-start gap-3 py-2">
                            {% if block.settings.item_image %}
                              <div class="w-10 h-10 shrink-0 overflow-hidden flex items-center justify-center">
                                <img
                                  src="{{ block.settings.item_image | image_url: width: 80, height: 80, crop: 'center' }}"
                                  alt="{{ block.settings.item_title }}"
                                  class="w-full h-full object-contain"
                                  width="60"
                                  height="60"
                                  loading="lazy">
                              </div>
                            {% endif %}
                            <div class="flex flex-col">
                              <span class="text-sm font-medium text-gray-900 leading-tight">
                                {% if block.settings.item_bold_text != blank %}
                                  {% assign bold_replacement = '<strong class="font-bold">' | append: block.settings.item_bold_text | append: '</strong>' %}
                                  {{ block.settings.item_title | replace: block.settings.item_bold_text, bold_replacement }}
                                {% else %}
                                  {{ block.settings.item_title }}
                                {% endif %}
                              </span>
                              {% if block.settings.item_subtitle != blank %}
                                <span class="text-xs text-gray-500 mt-0.5">{{ block.settings.item_subtitle }}</span>
                              {% endif %}
                            </div>
                          </a>
                        </div>
                      {% endif %}

                      {% comment %} Render menu_group block items {% endcomment %}
                      {% if block.type == 'menu_group' %}
                        {% for i in (1..8) %}
                          {% assign title_key = 'item' | append: i | append: '_title' %}
                          {% assign title = block.settings[title_key] %}
                          {% if title != blank %}
                            {% assign image_key = 'item' | append: i | append: '_image' %}
                            {% assign bold_key = 'item' | append: i | append: '_bold' %}
                            {% assign subtitle_key = 'item' | append: i | append: '_subtitle' %}
                            {% assign url_key = 'item' | append: i | append: '_url' %}
                            <div class="slashcart-mobile-tree-item">
                              <a href="{{ block.settings[url_key] | default: '#' }}" class="flex items-start gap-3 py-2">
                                {% if block.settings[image_key] %}
                                  <div class="w-10 h-10 shrink-0 overflow-hidden flex items-center justify-center">
                                    <img
                                      src="{{ block.settings[image_key] | image_url: width: 80, height: 80, crop: 'center' }}"
                                      alt="{{ title }}"
                                      class="w-full h-full object-contain"
                                      width="60"
                                      height="60"
                                      loading="lazy">
                                  </div>
                                {% endif %}
                                <div class="flex flex-col">
                                  <span class="text-sm font-medium text-gray-900 leading-tight">
                                    {% if block.settings[bold_key] != blank %}
                                      {% assign bold_replacement = '<strong class="font-bold">' | append: block.settings[bold_key] | append: '</strong>' %}
                                      {{ title | replace: block.settings[bold_key], bold_replacement }}
                                    {% else %}
                                      {{ title }}
                                    {% endif %}
                                  </span>
                                  {% if block.settings[subtitle_key] != blank %}
                                    <span class="text-xs text-gray-500 mt-0.5">{{ block.settings[subtitle_key] }}</span>
                                  {% endif %}
                                </div>
                              </a>
                            </div>
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% comment %} Show native Shopify child links if no custom blocks {% endcomment %}
                {% if has_child_links and has_custom_blocks == false %}
                  {% for child in link.links %}
                    <div class="slashcart-mobile-tree-item">
                      <a href="{{ child.url }}" class="flex items-center gap-3 py-2">
                        <span class="text-sm font-medium text-gray-700">{{ child.title }}</span>
                      </a>
                    </div>
                  {% endfor %}
                {% endif %}

                {% comment %} Show dropdown CTA blocks for this menu item {% endcomment %}
                {% for block in section.blocks %}
                  {% if block.type == 'dropdown_cta' %}
                    {% assign cta_parent = block.settings.parent_menu | downcase | strip %}
                    {% if cta_parent == link_title_lower %}
                      <div class="mt-4 pt-4 border-t border-gray-100">
                        <h4 class="text-sm font-semibold text-gray-900 mb-1">{{ block.settings.cta_title }}</h4>
                        <p class="text-xs text-gray-500 mb-3">{{ block.settings.cta_subtitle }}</p>
                        <a href="{{ block.settings.cta_url | default: '#' }}" class="inline-flex items-center gap-2 bg-[#3D9953] text-white px-4 py-2 rounded text-sm font-medium hover:bg-[#2d7a3e] transition-colors">
                          {{ block.settings.cta_button_text | default: 'Get Started' }}
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17 8l4 4m0 0l-4 4m4-4H3" />
                          </svg>
                        </a>
                      </div>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% else %}
          <a href="{{ link.url }}" class="block px-5 py-3 text-base font-medium text-gray-800 hover:bg-gray-50 transition-colors duration-200">
            {{ link.title }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Mobile CTAs as plain links -->
    <div class="px-5 py-4 border-t border-gray-100">
      {% if section.settings.cta1_text != blank %}
        <a href="{{ section.settings.cta1_url | default: '#' }}" class="block py-3 text-base font-medium text-gray-800 hover:text-gray-600 transition-colors duration-200">
          {{ section.settings.cta1_text }}
        </a>
      {% endif %}
    </div>
  </div>

</div>

