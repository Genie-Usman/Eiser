{% schema %}
  {
    "name": "Elite Megamenu",
    "settings": [
      {
        "type": "header",
        "content": "Announcement Bar"
      },
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show Announcement",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Text",
        "default": "ORDERS SHIP WITHIN 1 BUSINESS DAY"
      },
      {
        "type": "color",
        "id": "announcement_bg",
        "label": "Announcement Background",
        "default": "#b91c1c"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Announcement Text Color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Header Colors"
      },
      {
        "type": "color",
        "id": "header_top_bg",
        "label": "Top Bar Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "header_top_text",
        "label": "Top Bar Text Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "nav_bg",
        "label": "Navigation Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "nav_text",
        "label": "Navigation Text Color",
        "default": "#000000"
      },
      {
        "type": "header",
        "content": "Navigation"
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main Menu (Second Bar)",
        "default": "main-menu"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 150
      },
      {
        "type": "header",
        "content": "Sidebar Settings (Dropdown)"
      },
      {
        "type": "image_picker",
        "id": "sidebar_header_image",
        "label": "Sidebar Title Image (Replaces Text)"
      },
      {
        "type": "text",
        "id": "sidebar_title",
        "label": "Sidebar Title Text",
        "default": "SHOP WITH CONFIDENCE!"
      }
    ],

    "presets": [
      {
        "name": "Elite Athletic Megamenu"
      }
    ]
  }
{% endschema %}

{%- style -%}
  :root {
    --announcement-bg: {{ section.settings.announcement_bg }};
    --announcement-text: {{ section.settings.announcement_text_color }};
    --header-top-bg: {{ section.settings.header_top_bg }};
    --header-top-text: {{ section.settings.header_top_text }};
    --nav-bg: {{ section.settings.nav_bg }};
    --nav-text: {{ section.settings.nav_text }};
  }
  
  /* Custom Scrollbar for dropdown if needed */
  .elite-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .elite-scrollbar::-webkit-scrollbar-track {
    background: #f1f1f1; 
  }
  .elite-scrollbar::-webkit-scrollbar-thumb {
    background: #888; 
    border-radius: 3px;
  }
  .elite-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #555; 
  }
{%- endstyle -%}

<div 
  x-data="{ mobileMenuOpen: false }" 
  class="w-full relative z-40 font-sans"
  style="font-family: 'Inter', sans-serif;">

  <!-- 1. Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="w-full text-center py-2 px-4 text-xs font-bold uppercase tracking-wider relative z-51"
         style="background-color: var(--announcement-bg); color: var(--announcement-text);">
       <div class="flex justify-between items-center max-w-[1400px] mx-auto">
         <!-- Left Arrow (Fake) -->
         <span class="hidden md:block">&lt;</span>
         <span>{{ section.settings.announcement_text }}</span>
         <!-- Right Arrow (Fake) -->
         <span class="hidden md:block">&gt;</span>
       </div>
    </div>
  {% endif %}

  <header class="flex flex-col shadow-md">
    
    <!-- 2. Top Bar (Black BG) -->
    <div class="w-full" style="background-color: var(--header-top-bg); color: var(--header-top-text);">
        <div class="max-w-[1600px] mx-auto px-5 lg:px-10 h-[50px] flex items-center justify-between">
            
            <!-- Left: Utility Links -->
            <div class="hidden lg:flex items-center gap-6 text-[13px] font-bold uppercase tracking-wide">
                <a href="/pages/our-story" class="hover:text-gray-300 transition-colors">Our Story</a>
                <a href="/pages/reviews" class="hover:text-gray-300 transition-colors">Reviews</a>
                <a href="/pages/help-center" class="hover:text-gray-300 transition-colors">Help Center</a>
                {% if shop.customer_accounts_enabled %}
                    <a href="{{ routes.account_login_url }}" class="hover:text-gray-300 transition-colors">Log In</a>
                {% endif %}
            </div>
            
            <!-- Mobile Toggle -->
            <button 
              @click="mobileMenuOpen = !mobileMenuOpen"
              class="lg:hidden p-1 -ml-1 hover:opacity-75"
              aria-label="Toggle Menu">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>

            <!-- Center: Logo -->
            <div class="absolute left-1/2 transform -translate-x-1/2 top-[35px] lg:static lg:top-auto lg:translate-x-0 lg:transform-none">
                <a href="{{ routes.root_url }}">
                  {% if section.settings.logo != blank %}
                    <img
                      src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
                      alt="{{ shop.name }}"
                      style="width: {{ section.settings.logo_width }}px; max-height: 50px;"
                      class="h-auto object-contain"
                      loading="eager"
                      height="inherit"
                      width="inherit"
                      >
                  {% else %}
                    <!-- Fallback Text Logo mimicking styling in image -->
                    <div class="flex flex-col items-center leading-none">
                        <span class="font-black text-xl italic tracking-tighter">ELITE</span>
                        <span class="text-[10px] font-bold tracking-widest uppercase">ATHLETIC GEAR</span>
                    </div>
                  {% endif %}
                </a>
            </div>

            <!-- Right: Icons -->
            <div class="flex items-center gap-5 justify-end">
                <a href="{{ routes.search_url }}" class="hover:opacity-75" aria-label="Search">
                    <!-- Search Icon -->
                    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </a>
                {% if shop.customer_accounts_enabled %}
                    <a href="{{ routes.account_url }}" class="hover:opacity-75" aria-label="Account">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    </a>
                {% endif %}
                <a href="{{ routes.cart_url }}" class="hover:opacity-75 relative" aria-label="Cart">
                   <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                   <!-- Cart Badge -->
                   <span class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[9px] font-bold rounded-full w-4 h-4 flex items-center justify-center">0</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Navigation Bar (White BG) -->
    <div class="hidden lg:block w-full border-b border-gray-100 relative"
         style="background-color: var(--nav-bg); color: var(--nav-text);">
        <div class="max-w-[1600px] mx-auto px-10">
            <nav class="flex justify-center h-[60px]">
                {% if section.settings.main_menu != blank %}
                  <ul class="flex items-center gap-10 h-full"> 
                    {% for link in linklists[section.settings.main_menu].links %}
                        <li class="h-full flex items-center"
                            x-data="{ open: false }"
                            @mouseenter="open = true"
                            @mouseleave="open = false">
                            
                            <a href="{{ link.url }}" 
                               class="flex items-center gap-1 text-[14px] font-extrabold uppercase tracking-wide transition-colors duration-200"
                               :class="open ? 'text-(--announcement-bg)' : 'text-inherit'">
                                <span>{{ link.title }}</span>
                                {% if link.links != blank %}
                                    <svg class="w-3 h-3 transition-transform duration-200" :class="{'rotate-180': open}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                                {% endif %}
                            </a>

                            <!-- MEGAMENU DROPDOWN -->
                            {% if link.links != blank %}
                                <div 
                                    x-show="open"
                                    x-transition:enter="transition ease-out duration-200"
                                    x-transition:enter-start="opacity-0 translate-y-3"
                                    x-transition:enter-end="opacity-100 translate-y-0"
                                    x-transition:leave="transition ease-in duration-150"
                                    x-transition:leave-start="opacity-100 translate-y-0"
                                    x-transition:leave-end="opacity-0 translate-y-3"
                                    x-cloak
                                    class="absolute left-0 top-full w-full bg-white shadow-xl border-t border-gray-100 z-50 overflow-hidden"
                                    style="width: 100vw; left: 50%; transform: translateX(-50%);">
                                    
                                    <div class="w-full h-px bg-gray-100 absolute top-0"></div>

                                    <div class="max-w-[1700px] mx-auto p-10 flex gap-12">
                                        
                                        <!-- LEFT: Menu Grid (75%) -->
                                        <div class="grow grid grid-cols-4 gap-y-6 gap-x-8">
                                            {% for child in link.links %}
                                                
                                                <!-- Custom Config Logic -->
                                                {% assign menu_image = blank %}
                                                {% assign menu_icon = blank %}
                                                {% assign sale_text = blank %}
                                                {% assign sale_color = "#b91c1c" %}
                                                


                                                <!-- 0. Check for Dynamic Metafields (Collection/Product) -->
                                                {% if child.object != blank %}
                                                    {% if child.object.metafields.custom.menu_image != blank %}
                                                        {% assign menu_image = child.object.metafields.custom.menu_image %}
                                                    {% endif %}
                                                    {% if child.object.metafields.custom.menu_icon != blank %}
                                                        {% assign menu_icon = child.object.metafields.custom.menu_icon %}
                                                    {% endif %}
                                                    {% if child.object.metafields.custom.sale_text != blank %}
                                                        {% assign sale_text = child.object.metafields.custom.sale_text %}
                                                    {% endif %}
                                                    {% if child.object.metafields.custom.sale_color != blank %}
                                                        {% assign sale_color = child.object.metafields.custom.sale_color %}
                                                    {% endif %}
                                                {% endif %}
                                                


                                                <!-- 2. Fallback to Object Image -->
                                                {% if menu_image == blank %}
                                                    {% if child.type == 'collection_link' and child.object.image != blank %}
                                                        {% assign menu_image = child.object.image %}
                                                    {% elsif child.type == 'product_link' and child.object.featured_image != blank %}
                                                        {% assign menu_image = child.object.featured_image %}
                                                    {% endif %}
                                                {% endif %}

                                                <a href="{{ child.url }}" class="flex items-center gap-3 group">
                                                    
                                                    <!-- Image / Icon Container -->
                                                    <div class="w-8 h-8 shrink-0 flex items-center justify-center relative">
                                                        {% if menu_icon != blank %}
                                                            <!-- Priority: Custom Icon -->
                                                            <img src="{{ menu_icon | image_url: width: 32, height: 32 }}" 
                                                                 class="w-full h-full object-contain" 
                                                                 alt="{{ child.title }}" loading="lazy"
                                                                 height="inherit"
                                                                 width="inherit">
                                                        {% elsif menu_image != blank %}
                                                            <!-- Fallback: Custom Image or Collection Image -->
                                                            <img src="{{ menu_image | image_url: width: 64, height: 64 }}" 
                                                                 class="w-full h-full object-contain filter group-hover:brightness-110" 
                                                                 alt="{{ child.title }}" loading="lazy"
                                                                 height="inherit"
                                                                 width="inherit">
                                                        {% else %}
                                                            <!-- Generic Fallback -->
                                                            <div class="w-full h-full bg-gray-100 rounded-sm flex items-center justify-center text-gray-400">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                                            </div>
                                                        {% endif %}
                                                    </div>

                                                    <!-- Text -->
                                                    <div class="flex flex-col leading-tight">
                                                        <span class="text-[12px] font-bold uppercase text-gray-800 group-hover:text-(--announcement-bg) transition-colors">
                                                            {{ child.title }}
                                                        </span>
                                                        {% if sale_text != blank %}
                                                            <span class="text-[10px] font-bold uppercase" style="color: {{ sale_color }};">
                                                                {{ sale_text }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                </a>
                                            {% endfor %}
                                        </div>

                                        <!-- RIGHT: Sidebar / Trust Badges (25%) -->
                                        {% if section.settings.sidebar_title != blank %}
                                        <div class="w-[300px] shrink-0 border-l border-gray-100 pl-10 flex flex-col justify-center">
                                            
                                            <div class="mb-8 text-center flex justify-center">
                                                {% if section.settings.sidebar_header_image != blank %}
                                                    <img src="{{ section.settings.sidebar_header_image | image_url: width: 300 }}" 
                                                         alt="Shop With Confidence" 
                                                         class="max-w-full h-auto object-contain"
                                                         height="inherit"
                                                         width="inherit"
                                                         >
                                                {% elsif section.settings.sidebar_title != blank %}
                                                    <h3 class="text-[20px] font-black uppercase text-red-700 leading-tight">
                                                        {{ section.settings.sidebar_title }}
                                                    </h3>
                                                {% endif %}
                                            </div>



                                        </div>
                                        {% endif %}

                                    </div>
                                </div>
                            {% endif %}
                            
                        </li>
                    {% endfor %}
                  </ul>
                {% else %}
                    <div class="flex items-center text-sm font-bold text-gray-500">
                        Please select the "Elite Athletic Gear Menu" in the Customizer.
                    </div>
                {% endif %}
            </nav>
        </div>
    </div>
  </header>

   <!-- Mobile Menu Drawer (Simple Alpine Panel) -->
   <div x-show="mobileMenuOpen" style="display: none;" class="lg:hidden relative z-1001">
        <div class="fixed inset-0 bg-black/50" @click="mobileMenuOpen = false"></div>
        <div class="fixed inset-y-0 left-0 w-[300px] bg-white shadow-xl p-5 overflow-y-auto"
             x-transition:enter="transition ease-out duration-300 transform"
             x-transition:enter-start="-translate-x-full"
             x-transition:enter-end="translate-x-0"
             x-transition:leave="transition ease-in duration-300 transform"
             x-transition:leave-start="translate-x-0"
             x-transition:leave-end="-translate-x-full">
             
             <button @click="mobileMenuOpen = false" class="mb-5 flex items-center gap-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                <span class="font-bold uppercase">Close</span>
             </button>

             {% if section.settings.main_menu != blank %}
                <ul class="space-y-4">
                    {% for link in linklists[section.settings.main_menu].links %}
                        <li>
                            <div x-data="{ subOpen: false }">
                                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                                    <a href="{{ link.url }}" class="font-bold uppercase text-sm">{{ link.title }}</a>
                                    {% if link.links != blank %}
                                        <button @click="subOpen = !subOpen" class="p-2"><svg class="w-4 h-4" :class="{'rotate-180': subOpen}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></button>
                                    {% endif %}
                                </div>
                                {% if link.links != blank %}
                                    <ul x-show="subOpen" x-collapse class="pl-4 py-2 space-y-3 bg-gray-50">
                                        {% for child in link.links %}
                                            <li><a href="{{ child.url }}" class="text-sm text-gray-600 block">{{ child.title }}</a></li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
             {% endif %}
        </div>
   </div>

</div>