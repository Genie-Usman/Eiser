{% schema %}
  {
    "name": "Elite Megamenu",
    "settings": [
      {
        "type": "header",
        "content": "Announcement Bar"
      },
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show Announcement",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Text",
        "default": "ORDERS SHIP WITHIN 1 BUSINESS DAY"
      },
      {
        "type": "color",
        "id": "announcement_bg",
        "label": "Announcement Background",
        "default": "#b91c1c"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Announcement Text Color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Header Colors"
      },
      {
        "type": "color",
        "id": "header_top_bg",
        "label": "Top Bar Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "header_top_text",
        "label": "Top Bar Text Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "nav_bg",
        "label": "Navigation Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "nav_text",
        "label": "Navigation Text Color",
        "default": "#000000"
      },
      {
        "type": "header",
        "content": "Navigation"
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main Menu (Second Bar)",
        "default": "main-menu"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 150
      },
      {
        "type": "header",
        "content": "Sidebar Settings (Dropdown)"
      },
      {
        "type": "image_picker",
        "id": "sidebar_header_image",
        "label": "Sidebar Title Image (Replaces Text)"
      },
      {
        "type": "text",
        "id": "sidebar_title",
        "label": "Sidebar Title Text",
        "default": "SHOP WITH CONFIDENCE!"
      }
    ],
    "blocks": [
      {
        "type": "menu_sidebar_image",
        "name": "Menu Sidebar Image",
        "settings": [
          {
            "type": "text",
            "id": "menu_title",
            "label": "Menu Title (Exact Match)",
            "info": "e.g. 'SHOP BY PRODUCT' or 'BEST SELLING BUNDLES'"
          },
          {
            "type": "image_picker",
            "id": "sidebar_image",
            "label": "Sidebar Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Elite Athletic Megamenu"
      }
    ]
  }
{% endschema %}

{% style %}
  :root {
    --announcement-bg: {{ section.settings.announcement_bg }};
    --announcement-text: {{ section.settings.announcement_text_color }};
    --header-top-bg: {{ section.settings.header_top_bg }};
    --header-top-text: {{ section.settings.header_top_text }};
    --nav-bg: {{ section.settings.nav_bg }};
    --nav-text: {{ section.settings.nav_text }};
  }
  
  /* Custom Scrollbar for dropdown if needed */
  .elite-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .elite-scrollbar::-webkit-scrollbar-track {
    background: #f1f1f1; 
  }
  .elite-scrollbar::-webkit-scrollbar-thumb {
    background: #888; 
    border-radius: 3px;
  }
  .elite-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #555; 
  }
  
  /* Animated underline effect */
  .menu-link-underline {
    position: relative;
    display: inline-block;
  }
  .menu-link-underline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background-color: var(--announcement-bg);
    transition: width 0.3s ease;
  }
  .group\/item:hover .menu-link-underline::after {
    width: 100%;
  }
  
  /* Grandchild link underline effect */
  .grandchild-text {
    position: relative;
    display: inline-block;
    transition: color 0.2s ease;
  }
  .grandchild-text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background-color: var(--announcement-bg);
    transition: width 0.3s ease;
  }
  .grandchild-link:hover .grandchild-text {
    color: var(--announcement-bg);
  }
  .grandchild-link:hover .grandchild-text::after {
    width: 100%;
  }
{% endstyle %}

<div 
  x-data="{ mobileMenuOpen: false }" 
  class="w-full relative z-40 font-sans"
  style="font-family: 'Inter', sans-serif;">

  <!-- 1. Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="w-full py-2 px-4 text-xs font-bold uppercase tracking-wider relative z-51"
         style="background-color: var(--announcement-bg); color: var(--announcement-text);">
       <div class="grid grid-cols-3 items-center max-w-[1400px] mx-auto px-10">
         <!-- Left Arrow -->
         <span class="hidden md:block text-left cursor-pointer hover:opacity-75">&lt;</span>
         <!-- Center Text -->
         <span class="text-center">{{ section.settings.announcement_text }}</span>
         <!-- Right Arrow -->
         <span class="hidden md:block text-right cursor-pointer hover:opacity-75">&gt;</span>
       </div>
    </div>
  {% endif %}

  <header class="flex flex-col shadow-md">
    
    <!-- 2. Top Bar (Black BG) -->
    <div class="w-full" style="background-color: var(--header-top-bg); color: var(--header-top-text);">
        <div class="max-w-[1600px] mx-auto px-5 lg:px-32 h-[50px] grid grid-cols-3 items-center">
            
            <!-- Left: Utility Links -->
            <div class="hidden lg:flex items-center gap-6 text-[13px] font-bold uppercase tracking-wide">
                <a href="/pages/our-story" class="hover:text-gray-300 transition-colors">Our Story</a>
                <a href="/pages/reviews" class="hover:text-gray-300 transition-colors">Reviews</a>
                <a href="/pages/help-center" class="hover:text-gray-300 transition-colors">Help Center</a>
                {% if shop.customer_accounts_enabled %}
                    <a href="{{ routes.account_login_url }}" class="hover:text-gray-300 transition-colors">Log In</a>
                {% endif %}
            </div>
            
            <!-- Mobile Toggle (replaces left on mobile) -->
            <button 
              @click="mobileMenuOpen = !mobileMenuOpen"
              class="lg:hidden p-1 hover:opacity-75"
              aria-label="Toggle Menu">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>

            <!-- Center: Logo -->
            <div class="flex justify-center">
                <a href="{{ routes.root_url }}">
                  {% if section.settings.logo != blank %}
                    <img
                      src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
                      alt="{{ shop.name }}"
                      style="width: {{ section.settings.logo_width }}px; max-height: 50px;"
                      class="h-auto object-contain"
                      loading="eager"
                      height="inherit"
                      width="inherit"
                      >
                  {% else %}
                    <!-- Fallback Text Logo mimicking styling in image -->
                    <div class="flex flex-col items-center leading-none">
                        <span class="font-black text-xl italic tracking-tighter">ELITE</span>
                        <span class="text-[10px] font-bold tracking-widest uppercase">ATHLETIC GEAR</span>
                    </div>
                  {% endif %}
                </a>
            </div>

            <!-- Right: Icons -->
            <div class="flex items-center gap-5 justify-end">
                <a href="{{ routes.search_url }}" class="hover:opacity-75" aria-label="Search">
                    <!-- Search Icon -->
                    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </a>
                {% if shop.customer_accounts_enabled %}
                    <a href="{{ routes.account_url }}" class="hover:opacity-75" aria-label="Account">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    </a>
                {% endif %}
                <a href="{{ routes.cart_url }}" class="hover:opacity-75 relative" aria-label="Cart">
                   <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                   <!-- Cart Badge -->
                   <span class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[9px] font-bold rounded-full w-4 h-4 flex items-center justify-center">0</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Navigation Bar (White BG) -->
    <div class="hidden lg:block w-full border-b border-gray-100 relative"
         style="background-color: var(--nav-bg); color: var(--nav-text);">
        <div class="max-w-[1600px] mx-auto px-10">
            <nav class="flex justify-center h-[60px]">
                {% if section.settings.main_menu != blank %}
                  <ul class="flex items-center gap-10 h-full"> 
                    {% for link in linklists[section.settings.main_menu].links %}
                        <li class="h-full flex items-center"
                            x-data="{ open: false }"
                            @mouseenter="open = true"
                            @mouseleave="open = false">
                            
                            <a href="{{ link.url }}" 
                               class="flex items-center gap-1 text-[14px] font-extrabold uppercase tracking-wide transition-colors duration-200"
                               :class="open ? 'text-(--announcement-bg)' : 'text-inherit'"{% if link.links != blank %} onclick="event.preventDefault();"{% endif %}>
                                <span>{{ link.title }}</span>
                                {% if link.links != blank %}
                                <svg class="w-3 h-3 transition-transform duration-200" :class="{'rotate-180': open}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                                {% endif %}
                            </a>

                            <!-- MEGAMENU DROPDOWN -->
                            {% if link.links != blank %}
                                <div 
                                    x-show="open"
                                    x-transition:enter="transition ease-out duration-200"
                                    x-transition:enter-start="opacity-0 translate-y-3"
                                    x-transition:enter-end="opacity-100 translate-y-0"
                                    x-transition:leave="transition ease-in duration-150"
                                    x-transition:leave-start="opacity-100 translate-y-0"
                                    x-transition:leave-end="opacity-0 translate-y-3"
                                    x-cloak
                                    class="absolute left-0 top-full w-full bg-white shadow-xl border-t border-gray-100 z-50"
                                    style="width: 100vw; left: 50%; transform: translateX(-50%);">
                                    
                                    <div class="w-full h-px bg-gray-100 absolute top-0"></div>

                                    <div class="max-w-[1700px] mx-auto py-8 px-16 flex gap-16">
                                        
                                        <!-- LEFT: Menu Grid (75%) -->
                                        <div class="grow grid grid-cols-4 gap-y-5 gap-x-12 items-start content-start">
                                            {% for child in link.links %}
                                                
                                                <!-- Custom Config Logic -->
                                                {% assign menu_image = blank %}
                                                {% assign menu_icon = blank %}
                                                {% assign sale_text = blank %}
                                                {% assign sale_color = "#b91c1c" %}
                                                


                                                <!-- 0. Check for Dynamic Metafields (Collection/Product) -->
                                                {% if child.object != blank %}
                                                    {% if child.object.metafields.custom.menu_image != blank %}
                                                        {% assign menu_image = child.object.metafields.custom.menu_image %}
                                                    {% endif %}
                                                    {% if child.object.metafields.custom.menu_icon != blank %}
                                                        {% assign menu_icon = child.object.metafields.custom.menu_icon %}
                                                    {% endif %}
                                                    {% if child.object.metafields.custom.sale_text != blank %}
                                                        {% assign sale_text = child.object.metafields.custom.sale_text %}
                                                    {% endif %}
                                                    {% if child.object.metafields.custom.sale_color != blank %}
                                                        {% assign sale_color = child.object.metafields.custom.sale_color %}
                                                    {% endif %}
                                                {% endif %}
                                                


                                                <!-- 2. Fallback to Object Image -->
                                                {% if menu_image == blank %}
                                                    {% if child.object.image != blank %}
                                                        {% assign menu_image = child.object.image %}
                                                    {% elsif child.object.featured_image != blank %}
                                                        {% assign menu_image = child.object.featured_image %}
                                                    {% endif %}
                                                {% endif %}

                                                <div class="relative group/parent"
                                                     x-data="{ flyoutOpen: false }"
                                                     @mouseenter="flyoutOpen = true"
                                                     @mouseleave="flyoutOpen = false">
                                                    
                                                    <a href="{{ child.url }}" class="flex items-center gap-3 group/item w-full relative"{% if child.links != blank %} onclick="event.preventDefault();"{% endif %}>
                                                        
                                                        <!-- Image / Icon Container -->
                                                        <div class="w-8 h-8 shrink-0 flex items-center justify-center relative">
                                                            {% if menu_icon != blank %}
                                                                <!-- Priority: Custom Icon -->
                                                                <img src="{{ menu_icon | image_url: width: 32, height: 32 }}" 
                                                                    class="w-full h-full object-contain" 
                                                                    alt="{{ child.title }}" loading="lazy"
                                                                    height="inherit"
                                                                    width="inherit">
                                                            {% elsif menu_image != blank %}
                                                                <!-- Fallback: Custom Image or Collection Image -->
                                                                <img src="{{ menu_image | image_url: width: 64, height: 64 }}" 
                                                                    class="w-full h-full object-contain filter group-hover/item:brightness-110" 
                                                                    alt="{{ child.title }}" loading="lazy"
                                                                    height="inherit"
                                                                    width="inherit">
                                                            {% else %}
                                                                <!-- Generic Fallback -->
                                                                <div class="w-full h-full bg-gray-100 rounded-sm flex items-center justify-center text-gray-400">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                                                </div>
                                                            {% endif %}
                                                        </div>

                                                        <!-- Text -->
                                                        <div class="flex flex-col leading-tight mr-auto">
                                                            <span class="menu-link-underline text-[12px] font-bold uppercase text-gray-800 group-hover/item:text-(--announcement-bg) transition-colors">
                                                                {{ child.title }}
                                                            </span>
                                                            {% if sale_text != blank %}
                                                                <span class="text-[10px] font-bold uppercase" style="color: {{ sale_color }};">
                                                                    {{ sale_text }}
                                                                </span>
                                                            {% endif %}
                                                        </div>

                                                        <!-- Arrow if has children -->
                                                        {% if child.links != blank %}
                                                            <svg class="text-gray-400 w-3 h-3 group-hover/item:text-(--announcement-bg)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                                        {% endif %}
                                                    </a>

                                                    <!-- Grandchild Flyout -->
                                                    {% if child.links != blank %}
                                                        <div x-show="flyoutOpen"
                                                             x-transition:enter="transition ease-out duration-150"
                                                             x-transition:enter-start="opacity-0 translate-y-1"
                                                             x-transition:enter-end="opacity-100 translate-y-0"
                                                             x-cloak
                                                             class="absolute left-full -top-2 -ml-2 w-[280px] bg-white shadow-lg border border-gray-200 py-4 z-50">
                                                            
                                                            <ul class="flex flex-col gap-1">
                                                                {% for grandchild in child.links %}
                                                                    {% assign gc_image = blank %}
                                                                    {% if grandchild.object != blank %}
                                                                       {% if grandchild.object.metafields.custom.menu_image != blank %}
                                                                            {% assign gc_image = grandchild.object.metafields.custom.menu_image %}
                                                                       {% elsif grandchild.object.image != blank %}
                                                                            {% assign gc_image = grandchild.object.image %}
                                                                       {% elsif grandchild.object.featured_image != blank %}
                                                                            {% assign gc_image = grandchild.object.featured_image %}
                                                                       {% endif %}
                                                                    {% endif %}

                                                                    <li>
                                                                        <a href="{{ grandchild.url }}" class="grandchild-link flex items-center gap-4 px-5 py-3 hover:bg-gray-50 transition-colors">
                                                                            <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-gray-50 rounded">
                                                                                {% if gc_image != blank %}
                                                                                    <img src="{{ gc_image | image_url: width: 96, height: 96 }}" 
                                                                                         class="w-full h-full object-contain" 
                                                                                         alt="{{ grandchild.title }}"
                                                                                         height="inherit"
                                                                                         width="inherit">
                                                                                {% else %}
                                                                                    <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                                                                {% endif %}
                                                                            </div>
                                                                            <span class="grandchild-text text-[12px] font-bold uppercase text-gray-800 leading-tight">
                                                                                {{ grandchild.title }}
                                                                            </span>
                                                                        </a>
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        </div>
                                                    {% endif %}

                                                </div>
                                            {% endfor %}
                                        </div>

                                        <!-- RIGHT: Sidebar -->
                                        <div class="w-1/3 shrink-0 border-l border-gray-100 pl-10 flex flex-col justify-center">
                                            
                                            <div class="mb-4 text-center flex justify-center flex-col items-center">
                                                {% comment %} Try to get a unique image for each menu item {% endcomment %}
                                                {% assign sidebar_image = blank %}
                                                {% assign link_title_down = link.title | downcase | strip %}
                                                
                                                {% comment %} 1. Check for matching block in Theme Editor {% endcomment %}
                                                {% for block in section.blocks %}
                                                    {% if block.type == 'menu_sidebar_image' %}
                                                        {% assign block_title = block.settings.menu_title | downcase | strip %}
                                                        {% if block_title == link_title_down and block.settings.sidebar_image != blank %}
                                                            {% assign sidebar_image = block.settings.sidebar_image %}
                                                            {% break %}
                                                        {% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                                
                                                {% comment %} 2. Fallback to global setting {% endcomment %}
                                                {% if sidebar_image == blank and section.settings.sidebar_header_image != blank %}
                                                    {% assign sidebar_image = section.settings.sidebar_header_image %}
                                                {% endif %}
                                                
                                                {% if sidebar_image != blank %}
                                                    <img src="{{ sidebar_image | image_url: width: 500 }}" 
                                                         alt="{{ link.title }}" 
                                                         class="max-w-full h-auto object-contain"
                                                         height="inherit"
                                                         width="inherit"
                                                         >
                                                {% elsif section.settings.sidebar_title != blank %}
                                                    <h3 class="text-[20px] font-black uppercase text-red-700 leading-tight">
                                                        {{ section.settings.sidebar_title }}
                                                    </h3>
                                                {% endif %}
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            {% endif %}
                            
                        </li>
                    {% endfor %}
                  </ul>
                {% else %}
                    <div class="flex items-center text-sm font-bold text-gray-500">
                        Please select the "Elite Athletic Gear Menu" in the Customizer.
                    </div>
                {% endif %}
            </nav>
        </div>
    </div>
  </header>

   <!-- Mobile Menu Drawer (Full-Featured Design) -->
   <div x-show="mobileMenuOpen" 
        x-data="{ currentPanel: 'main', activeChild: 0, activeGrandchild: 0 }" 
        style="display: none;" 
        class="lg:hidden fixed inset-0 z-[1001]">
        
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/50" @click="mobileMenuOpen = false; currentPanel = 'main'"></div>
        
        <!-- Drawer Container -->
        <div class="absolute inset-y-0 left-0 w-full max-w-[400px] bg-white shadow-xl flex flex-col"
             x-transition:enter="transition ease-out duration-300 transform"
             x-transition:enter-start="-translate-x-full"
             x-transition:enter-end="translate-x-0"
             x-transition:leave="transition ease-in duration-300 transform"
             x-transition:leave-start="translate-x-0"
             x-transition:leave-end="-translate-x-full">
             
             <!-- Header -->
             <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100" style="background-color: var(--header-top-bg); color: var(--header-top-text);">
                <button @click="mobileMenuOpen = false; currentPanel = 'main'" class="p-1 hover:opacity-75" aria-label="Close menu">
                   <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                
                <a href="{{ routes.root_url }}" class="flex-1 flex justify-center">
                  {% if section.settings.logo != blank %}
                    <img src="{{ section.settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}" class="h-8 object-contain" loading="eager">
                  {% else %}
                    <div class="flex flex-col items-center leading-none">
                        <span class="font-black text-lg italic tracking-tighter">ELITE</span>
                        <span class="text-[8px] font-bold tracking-widest uppercase">ATHLETIC GEAR</span>
                    </div>
                  {% endif %}
                </a>
                
                <div class="flex items-center gap-3">
                    <a href="{{ routes.search_url }}" class="hover:opacity-75" aria-label="Search">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </a>
                    <a href="{{ routes.cart_url }}" class="hover:opacity-75 relative" aria-label="Cart">
                       <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                       <span class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[9px] font-bold rounded-full w-4 h-4 flex items-center justify-center">{{ cart.item_count }}</span>
                    </a>
                </div>
             </div>
             
             <!-- Scrollable Content Area -->
             <div class="flex-1 overflow-y-auto overflow-x-hidden relative">
               
               <!-- MAIN PANEL -->
               <div x-show="currentPanel === 'main'"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 -translate-x-4"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    class="absolute inset-0 flex flex-col">
                    
                  {% if section.settings.main_menu != blank %}
                    <ul class="flex-1">
                      {% for link in linklists[section.settings.main_menu].links %}
                        {% comment %} Get image for this menu item {% endcomment %}
                        {% assign menu_image = blank %}
                        {% if link.object != blank %}
                          {% if link.object.metafields.custom.menu_image != blank %}
                            {% assign menu_image = link.object.metafields.custom.menu_image %}
                          {% elsif link.object.image != blank %}
                            {% assign menu_image = link.object.image %}
                          {% elsif link.object.featured_image != blank %}
                            {% assign menu_image = link.object.featured_image %}
                          {% endif %}
                        {% endif %}
                        
                        {% comment %} Fallback: Check blocks for matching sidebar image {% endcomment %}
                        {% if menu_image == blank %}
                          {% assign link_title_down = link.title | downcase | strip %}
                          {% for block in section.blocks %}
                            {% if block.type == 'menu_sidebar_image' %}
                              {% assign block_title = block.settings.menu_title | downcase | strip %}
                              {% if block_title == link_title_down and block.settings.sidebar_image != blank %}
                                {% assign menu_image = block.settings.sidebar_image %}
                                {% break %}
                              {% endif %}
                            {% endif %}
                          {% endfor %}
                        {% endif %}
                        
                        <li class="border-b border-gray-100">
                          {% if link.links != blank %}
                            <button 
                              @click="activeChild = {{ forloop.index0 }}; currentPanel = 'child-{{ forloop.index0 }}'"
                              class="w-full flex items-center gap-4 py-4 px-4 hover:bg-gray-50 transition-colors">
                              
                              <!-- Image -->
                              <div class="w-16 h-16 shrink-0 flex items-center justify-center">
                                {% if menu_image != blank %}
                                  <img src="{{ menu_image | image_url: width: 128 }}" alt="{{ link.title }}" class="w-full h-full object-contain">
                                {% else %}
                                  <div class="w-full h-full bg-gray-100 rounded flex items-center justify-center">
                                    <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                  </div>
                                {% endif %}
                              </div>
                              
                              <!-- Title -->
                              <span class="flex-1 text-left text-[13px] font-bold uppercase tracking-wide">{{ link.title }}</span>
                              
                              <!-- Chevron -->
                              <span class="text-gray-400 text-sm font-bold">>></span>
                            </button>
                          {% else %}
                            <a href="{{ link.url }}" class="w-full flex items-center gap-4 py-4 px-4 hover:bg-gray-50 transition-colors">
                              <!-- Image -->
                              <div class="w-16 h-16 shrink-0 flex items-center justify-center">
                                {% if menu_image != blank %}
                                  <img src="{{ menu_image | image_url: width: 128 }}" alt="{{ link.title }}" class="w-full h-full object-contain">
                                {% else %}
                                  <div class="w-full h-full bg-gray-100 rounded flex items-center justify-center">
                                    <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                  </div>
                                {% endif %}
                              </div>
                              
                              <!-- Title -->
                              <span class="flex-1 text-left text-[13px] font-bold uppercase tracking-wide">{{ link.title }}</span>
                            </a>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                  
                  <!-- Utility Links -->
                  <div class="border-t border-gray-200 py-2">
                    <a href="/pages/our-story" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50">
                      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                      <span class="text-[13px] font-bold uppercase">Our Story</span>
                    </a>
                    <a href="/pages/reviews" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50">
                      <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                      <span class="text-[13px] font-bold uppercase">Reviews</span>
                    </a>
                    <a href="/pages/help-center" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50">
                      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                      <span class="text-[13px] font-bold uppercase">Help Center</span>
                    </a>
                    {% if shop.customer_accounts_enabled %}
                      <a href="{{ routes.account_login_url }}" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50">
                        <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
                        <span class="text-[13px] font-bold uppercase">Log In</span>
                      </a>
                    {% endif %}
                  </div>
                  
                  <!-- Social Footer -->
                  <div class="border-t border-gray-200 px-4 py-4" style="background-color: var(--header-top-bg); color: var(--header-top-text);">
                    <p class="text-[10px] font-bold uppercase tracking-wide mb-3 text-center">Join 400K+ Athletes Who Follow Us</p>
                    <div class="flex justify-center gap-4">
                      <!-- X (Twitter) -->
                      <a href="#" class="hover:opacity-75"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg></a>
