                      <!-- Instagram -->
                      <a href="#" class="hover:opacity-75"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path></svg></a>
                      <!-- TikTok -->
                      <a href="#" class="hover:opacity-75"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg></a>
                      <!-- Snapchat -->
                      <a href="#" class="hover:opacity-75"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.12 1.033-.301a.603.603 0 01.257-.053c.243 0 .485.093.629.265a.561.561 0 01.107.39c-.069.343-.349.674-.884.958-.192.106-.449.243-.729.39-.673.352-1.434.75-1.67 1.204a.549.549 0 00-.049.205c.015.217.152.503.543.982.777.965 1.659 1.598 2.137 1.826.281.136.507.285.64.46.14.18.243.42.197.742-.09.586-.657.977-1.258 1.126-.53.133-1.212.21-2.025.237a8.306 8.306 0 00-.254.012c-.106.007-.215.022-.385.13-.111.073-.228.18-.348.292-.173.159-.378.354-.605.518-.481.341-1.08.58-1.69.58-.208 0-.409-.026-.602-.085-.469-.138-.97-.406-1.504-.76-.49-.324-.977-.72-1.386-1.006-.24-.17-.45-.31-.576-.385a1.19 1.19 0 00-.543-.139c-.241 0-.498.055-.833.164a7.82 7.82 0 00-1.118.51c-.485.284-1.024.44-1.48.44-.434 0-.807-.136-1.097-.495a1.03 1.03 0 01-.217-.628c0-.305.108-.582.303-.826.134-.168.33-.304.573-.431.52-.269 1.4-.904 2.175-1.869.39-.479.528-.765.543-.982a.549.549 0 00-.05-.205c-.235-.454-.996-.852-1.669-1.204a9.73 9.73 0 01-.729-.39c-.535-.284-.815-.615-.884-.958a.561.561 0 01.107-.39.64.64 0 01.629-.265.603.603 0 01.257.053c.374.181.733.285 1.033.301.198 0 .326-.045.401-.09a6.59 6.59 0 01-.033-.57l-.003-.06c-.104-1.628-.23-3.654.299-4.847C7.86 1.069 11.216.793 12.206.793z"></path></svg></a>
                      <!-- YouTube -->
                      <a href="#" class="hover:opacity-75"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg></a>
                    </div>
                  </div>
               </div>
               
               <!-- PRE-RENDERED CHILD PANELS -->
               {% if section.settings.main_menu != blank %}
                 {% for link in linklists[section.settings.main_menu].links %}
                   {% if link.links != blank %}
                     <div x-show="currentPanel === 'child-{{ forloop.index0 }}'"
                          x-transition:enter="transition ease-out duration-200"
                          x-transition:enter-start="opacity-0 translate-x-4"
                          x-transition:enter-end="opacity-100 translate-x-0"
                          class="absolute inset-0 flex flex-col bg-white">
                       
                       <!-- Back Button -->
                       <button @click="currentPanel = 'main'" class="flex items-center gap-2 px-4 py-3 border-b border-gray-200 hover:bg-gray-50">
                         <span class="text-gray-600 font-bold text-sm">&lt;&lt;</span>
                         <span class="text-[13px] font-bold uppercase">{{ link.title }}</span>
                       </button>
                       
                       <!-- Child Links -->
                       <ul class="flex-1 overflow-y-auto">
                         {% for child in link.links %}
                           {% assign child_image = blank %}
                           {% if child.object != blank %}
                             {% if child.object.metafields.custom.menu_image != blank %}
                               {% assign child_image = child.object.metafields.custom.menu_image %}
                             {% elsif child.object.image != blank %}
                               {% assign child_image = child.object.image %}
                             {% elsif child.object.featured_image != blank %}
                               {% assign child_image = child.object.featured_image %}
                             {% endif %}
                           {% endif %}
                           
                           <li class="border-b border-gray-100">
                             {% if child.links != blank %}
                               <button 
                                 @click="currentPanel = 'grandchild-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}'"
                                 class="w-full flex items-center gap-4 py-4 px-4 hover:bg-gray-50 transition-colors">
                                 <div class="w-12 h-12 shrink-0 flex items-center justify-center">
                                   {% if child_image != blank %}
                                     <img src="{{ child_image | image_url: width: 96 }}" alt="{{ child.title }}" class="w-full h-full object-contain">
                                   {% else %}
                                     <div class="w-full h-full bg-gray-100 rounded flex items-center justify-center">
                                       <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                     </div>
                                   {% endif %}
                                 </div>
                                 <span class="flex-1 text-left text-[13px] font-bold uppercase tracking-wide">{{ child.title }}</span>
                                 <span class="text-gray-400 text-sm font-bold">>></span>
                               </button>
                             {% else %}
                               <a href="{{ child.url }}" class="w-full flex items-center gap-4 py-4 px-4 hover:bg-gray-50 transition-colors">
                                 <div class="w-12 h-12 shrink-0 flex items-center justify-center">
                                   {% if child_image != blank %}
                                     <img src="{{ child_image | image_url: width: 96 }}" alt="{{ child.title }}" class="w-full h-full object-contain">
                                   {% else %}
                                     <div class="w-full h-full bg-gray-100 rounded flex items-center justify-center">
                                       <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                     </div>
                                   {% endif %}
                                 </div>
                                 <span class="flex-1 text-left text-[13px] font-bold uppercase tracking-wide">{{ child.title }}</span>
                               </a>
                             {% endif %}
                           </li>
                         {% endfor %}
                       </ul>
                     </div>
                     
                     <!-- GRANDCHILD PANELS for this parent -->
                     {% for child in link.links %}
                       {% if child.links != blank %}
                         <div x-show="currentPanel === 'grandchild-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}'"
                              x-transition:enter="transition ease-out duration-200"
                              x-transition:enter-start="opacity-0 translate-x-4"
                              x-transition:enter-end="opacity-100 translate-x-0"
                              class="absolute inset-0 flex flex-col bg-white">
                           
                           <!-- Back Button -->
                           <button @click="currentPanel = 'child-{{ forloop.parentloop.index0 }}'" class="flex items-center gap-2 px-4 py-3 border-b border-gray-200 hover:bg-gray-50">
                             <span class="text-gray-600 font-bold text-sm">&lt;&lt;</span>
                             <span class="text-[13px] font-bold uppercase">{{ child.title }}</span>
                           </button>
                           
                           <!-- Grandchild Links -->
                           <ul class="flex-1 overflow-y-auto">
                             {% for grandchild in child.links %}
                               {% assign gc_image = blank %}
                               {% if grandchild.object != blank %}
                                 {% if grandchild.object.metafields.custom.menu_image != blank %}
                                   {% assign gc_image = grandchild.object.metafields.custom.menu_image %}
                                 {% elsif grandchild.object.image != blank %}
                                   {% assign gc_image = grandchild.object.image %}
                                 {% elsif grandchild.object.featured_image != blank %}
                                   {% assign gc_image = grandchild.object.featured_image %}
                                 {% endif %}
                               {% endif %}
                               
                               <li class="border-b border-gray-100">
                                 <a href="{{ grandchild.url }}" class="w-full flex items-center gap-4 py-4 px-4 hover:bg-gray-50 transition-colors">
                                   <div class="w-12 h-12 shrink-0 flex items-center justify-center">
                                     {% if gc_image != blank %}
                                       <img src="{{ gc_image | image_url: width: 96 }}" alt="{{ grandchild.title }}" class="w-full h-full object-contain">
                                     {% else %}
                                       <div class="w-full h-full bg-gray-100 rounded flex items-center justify-center">
                                         <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                       </div>
                                     {% endif %}
                                   </div>
                                   <span class="flex-1 text-left text-[13px] font-bold uppercase tracking-wide">{{ grandchild.title }}</span>
                                 </a>
                               </li>
                             {% endfor %}
                           </ul>
                         </div>
                       {% endif %}
                     {% endfor %}
                   {% endif %}
                 {% endfor %}
               {% endif %}
               
             </div>
        </div>
   </div>

</div>