              href="{{ section.settings.instagram_url }}"
              target="_blank"
              class="hover:opacity-75 transition-opacity">
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a
              href="{{ section.settings.pinterest_url }}"
              target="_blank"
              class="hover:opacity-75 transition-opacity">
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24">
                <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z" />
              </svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a
              href="{{ section.settings.tiktok_url }}"
              target="_blank"
              class="hover:opacity-75 transition-opacity">
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <!-- Header -->
  <header class="w-full" style="background-color: var(--gogreek-header-bg);">
    <div class="max-w-[1400px] mx-auto px-4 lg:px-8">

      <!-- Top Row: Currency | Logo | Icons -->
      <div class="flex items-center justify-between py-4">

        <!-- Left: Currency Selector (Desktop) / Hamburger (Mobile) -->
        <div class="flex items-center gap-4 w-[150px]">
          <!-- Mobile Hamburger -->
          <button
            @click="mobileMenuOpen = !mobileMenuOpen"
            class="lg:hidden p-2"
            style="color: var(--gogreek-header-text);">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <!-- Currency (Desktop) -->
          <div class="hidden lg:flex items-center gap-1 text-xs" style="color: var(--gogreek-header-text);">
            <span>United States (USD $)</span>
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

        <!-- Center: Logo -->
        <a href="{{ routes.root_url }}" class="flex items-center justify-center">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              height="inherit"
              width="inherit"
              style="width: {{ section.settings.logo_width }}px; max-height: 60px;"
              class="h-auto object-contain"
              loading="eager">
          {% else %}
            <span class="text-2xl font-bold" style="color: var(--gogreek-header-text);">{{ shop.name }}</span>
          {% endif %}
        </a>

        <!-- Right: Icons -->
        <div class="flex items-center gap-4 w-[150px] justify-end" style="color: var(--gogreek-header-text);">
          <!-- User -->
          <a href="{{ routes.account_url }}" class="hidden lg:block hover:opacity-75 transition-opacity">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </a>

          <!-- Search -->
          <button class="hover:opacity-75 transition-opacity">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>

          <!-- Cart -->
          <a href="{{ routes.cart_url }}" class="relative hover:opacity-75 transition-opacity">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            {% if cart.item_count > 0 %}
              <span class="absolute -top-2 -right-2 w-4 h-4 text-xs flex items-center justify-center rounded-full bg-white text-black">
                {{ cart.item_count }}
              </span>
            {% endif %}
          </a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="hidden lg:block w-full relative" style="background-color: var(--gogreek-nav-bg);">
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
        <div class="flex items-center justify-center gap-6">
          {% if section.settings.main_menu != blank %}
            {% for link in linklists[section.settings.main_menu].links %}
            {% assign link_title_lower = link.title | downcase | strip %}

              {% comment %} Check if this link has a block {% endcomment %}
              {% assign has_dropdown = false %}
              {% for block in section.blocks %}
                {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                {% if block_parent == link_title_lower %}
                  {% assign has_dropdown = true %}
                  {% break %}
                {% endif %}
              {% endfor %}

              <div
                class="static"
                @mouseenter="openDropdown = '{{ link.title | handleize }}'"
                @mouseleave="openDropdown = null">

                <a
                  href="{{ link.url }}"
                  class="gogreek-nav-link py-4 text-xs font-medium uppercase tracking-wider transition-colors inline-block relative"
                  style="color: var(--gogreek-nav-text);"
                  {% if has_dropdown %}
                  @click.prevent{% endif %}>
                  {{ link.title }}
                </a>

                <!-- Dropdown (Full Width) -->
                {% if has_dropdown %}
                  <div
                    x-show="openDropdown === '{{ link.title | handleize }}'"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-cloak
                    class="gogreek-dropdown absolute left-0 right-0 top-full w-full"
                    style="z-index: 9999;">

                    <div class="w-full py-6 px-8 shadow-xl" style="background-color: var(--gogreek-dropdown-bg);">
                      <div class="max-w-[1200px] mx-auto">
                        {% for block in section.blocks %}
                          {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                          {% if block_parent == link_title_lower %}

                            {% case block.type %}
                              {% when 'grid_menu' %}
                                <!-- Grid Layout (Logo + Title) - Full Width -->
                                <div class="grid gap-y-4 gap-x-6" style="grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));">
                                  {% for i in (1..24) %}
                                    {% assign img_key = 'item' | append: i | append: '_image' %}
                                    {% assign title_key = 'item' | append: i | append: '_title' %}
                                    {% assign url_key = 'item' | append: i | append: '_url' %}

                                    {% if block.settings[title_key] != blank %}
                                      <a href="{{ block.settings[url_key] | default: '#' }}" class="flex items-center gap-3 p-2 rounded-lg transition-colors group">
                                        {% if block.settings[img_key] != blank %}
                                          <img
                                            src="{{ block.settings[img_key] | image_url: width: 80 }}"
                                            alt="{{ block.settings[title_key] }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-10 h-10 rounded-full object-cover shrink-0">
                                        {% else %}
                                          <div class="w-10 h-10 rounded-full bg-white/20 shrink-0 flex items-center justify-center text-xs" style="color: var(--gogreek-dropdown-text);">
                                            {{ block.settings[title_key] | slice: 0, 3 | upcase }}
                                          </div>
                                        {% endif %}
                                        <span class="gogreek-dropdown-link text-sm" style="color: var(--gogreek-dropdown-text);">{{ block.settings[title_key] }}</span>
                                      </a>
                                    {% endif %}
                                  {% endfor %}
                                </div>

                              {% when 'columns_menu' %}
                                <!-- Columns Layout -->
                                <div class="flex gap-8">
                                  {% if block.settings.col1_title != blank %}
                                    <div class="min-w-[140px]">
                                      <h4 class="text-sm font-bold mb-3" style="color: var(--gogreek-dropdown-text);">{{ block.settings.col1_title }}</h4>
                                      <ul class="space-y-2">
                                        {% assign lines = block.settings.col1_links | newline_to_br | split: '<br />' %}
                                        {% for line in lines %}
                                          {% assign parts = line | split: '|' %}
                                          {% if parts.size >= 2 %}
                                            <li>
                                              <a
                                                href="{{ parts[1] | strip }}"
                                                class="gogreek-dropdown-link text-sm transition-opacity"
                                                style="color: var(--gogreek-dropdown-text);">{{ parts[0] | strip }}</a>
                                            </li>
                                          {% endif %}
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  {% endif %}

                                  {% if block.settings.col2_title != blank %}
                                    <div class="min-w-[140px]">
                                      <h4 class="text-sm font-bold mb-3" style="color: var(--gogreek-dropdown-text);">{{ block.settings.col2_title }}</h4>
                                      <ul class="space-y-2">
                                        {% assign lines = block.settings.col2_links | newline_to_br | split: '<br />' %}
                                        {% for line in lines %}
                                          {% assign parts = line | split: '|' %}
                                          {% if parts.size >= 2 %}
                                            <li>
                                              <a
                                                href="{{ parts[1] | strip }}"
                                                class="gogreek-dropdown-link text-sm transition-opacity"
                                                style="color: var(--gogreek-dropdown-text);">{{ parts[0] | strip }}</a>
                                            </li>
                                          {% endif %}
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  {% endif %}

                                  {% if block.settings.col3_title != blank %}
                                    <div class="min-w-[140px]">
                                      <h4 class="text-sm font-bold mb-3" style="color: var(--gogreek-dropdown-text);">{{ block.settings.col3_title }}</h4>
                                      <ul class="space-y-2">
                                        {% assign lines = block.settings.col3_links | newline_to_br | split: '<br />' %}
                                        {% for line in lines %}
                                          {% assign parts = line | split: '|' %}
                                          {% if parts.size >= 2 %}
                                            <li>
                                              <a
                                                href="{{ parts[1] | strip }}"
                                                class="gogreek-dropdown-link text-sm transition-opacity"
                                                style="color: var(--gogreek-dropdown-text);">{{ parts[0] | strip }}</a>
                                            </li>
                                          {% endif %}
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  {% endif %}

                                  {% if block.settings.col4_title != blank %}
                                    <div class="min-w-[140px]">
                                      <h4 class="text-sm font-bold mb-3" style="color: var(--gogreek-dropdown-text);">{{ block.settings.col4_title }}</h4>
                                      <ul class="space-y-2">
                                        {% assign lines = block.settings.col4_links | newline_to_br | split: '<br />' %}
                                        {% for line in lines %}
                                          {% assign parts = line | split: '|' %}
                                          {% if parts.size >= 2 %}
                                            <li>
                                              <a
                                                href="{{ parts[1] | strip }}"
                                                class="gogreek-dropdown-link text-sm transition-opacity"
                                                style="color: var(--gogreek-dropdown-text);">{{ parts[0] | strip }}</a>
                                            </li>
                                          {% endif %}
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  {% endif %}

                                  <!-- Featured Images (Right Side) -->
                                  {% if block.settings.featured_image1 != blank or block.settings.featured_image2 != blank %}
                                    <div class="ml-auto flex gap-6" style="flex-shrink: 0;">
                                      {% if block.settings.featured_image1 != blank %}
                                        <a
                                          href="{{ block.settings.featured_url1 | default: '#' }}"
                                          class="block hover:opacity-90 transition-opacity"
                                          style="flex: 0 0 auto;">
                                          <img
                                            src="{{ block.settings.featured_image1 | image_url: width: 600, height: 400, crop: 'center' }}"
                                            alt="Featured Product"
                                            height="inherit"
                                            width="inherit"
                                            style="width: 300px; height: 200px; object-fit: cover;">
                                        </a>
                                      {% endif %}
                                      {% if block.settings.featured_image2 != blank %}
                                        <a
                                          href="{{ block.settings.featured_url2 | default: '#' }}"
                                          class="block hover:opacity-90 transition-opacity"
                                          style="flex: 0 0 auto;">
                                          <img
                                            src="{{ block.settings.featured_image2 | image_url: width: 600, height: 400, crop: 'center' }}"
                                            alt="Featured Product"
                                            height="inherit"
                                            width="inherit"
                                            style="width: 300px; height: 200px; object-fit: cover;">
                                        </a>
                                      {% endif %}
                                    </div>
                                  {% endif %}
                                </div>

                                <!-- Tagline -->
                                {% if block.settings.tagline != blank %}
                                  <p class="mt-4 text-sm" style="color: var(--gogreek-dropdown-text);">{{ block.settings.tagline }}</p>
                                {% endif %}

                              {% when 'image_gallery_menu' %}
                                <!-- Image Gallery Layout (New & Trending) - 3 Equal Sections -->
                                <div class="grid grid-cols-3 gap-6">
                                  {% if block.settings.section1_title != blank %}
                                    <a href="{{ block.settings.section1_url | default: '#' }}" class="block group">
                                      <h4 class="text-sm uppercase  mb-4" style="color: var(--gogreek-dropdown-text);">
                                        <span class="gogreek-dropdown-link">{{ block.settings.section1_title }}</span>
                                      </h4>
                                      {% if block.settings.section1_image != blank %}
                                        <div class="overflow-hidden">
                                          <img
                                            src="{{ block.settings.section1_image | image_url: width: 400 }}"
                                            alt="{{ block.settings.section1_title }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-full h-72 object-cover group-hover:opacity-90 transition-opacity">
                                        </div>
                                      {% endif %}
                                    </a>
                                  {% endif %}
                                  {% if block.settings.section2_title != blank %}
                                    <a href="{{ block.settings.section2_url | default: '#' }}" class="block group">
                                      <h4 class="text-sm uppercase mb-4" style="color: var(--gogreek-dropdown-text);">
                                        <span class="gogreek-dropdown-link">{{ block.settings.section2_title }}</span>
                                      </h4>
                                      {% if block.settings.section2_image != blank %}
                                        <div class="overflow-hidden">
                                          <img
                                            src="{{ block.settings.section2_image | image_url: width: 400 }}"
                                            alt="{{ block.settings.section2_title }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-full h-72 object-cover group-hover:opacity-90 transition-opacity">
                                        </div>
                                      {% endif %}
                                    </a>
                                  {% endif %}
                                  {% if block.settings.section3_title != blank %}
                                    <a href="{{ block.settings.section3_url | default: '#' }}" class="block group">
                                      <h4 class="text-sm uppercase mb-4" style="color: var(--gogreek-dropdown-text);">
                                        <span class="gogreek-dropdown-link">{{ block.settings.section3_title }}</span>
                                      </h4>
                                      {% if block.settings.section3_image != blank %}
                                        <div class="overflow-hidden">
                                          <img
                                            src="{{ block.settings.section3_image | image_url: width: 400 }}"
                                            alt="{{ block.settings.section3_title }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-full h-72 object-cover group-hover:opacity-90 transition-opacity">
                                        </div>
                                      {% endif %}
                                    </a>
                                  {% endif %}
                                </div>

                              {% when 'thumbnail_grid_menu' %}
                                <!-- Thumbnail Grid Layout (Accessories & Gifts) -->
                                <div class="grid gap-6" style="grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));">
                                  {% for i in (1..13) %}
                                    {% assign img_key = 'item' | append: i | append: '_image' %}
                                    {% assign title_key = 'item' | append: i | append: '_title' %}
                                    {% assign url_key = 'item' | append: i | append: '_url' %}
                                    {% if block.settings[title_key] != blank %}
                                      <a href="{{ block.settings[url_key] | default: '#' }}" class="flex items-center gap-3 group hover:opacity-80 transition-opacity">
                                        {% if block.settings[img_key] != blank %}
                                          <img
                                            src="{{ block.settings[img_key] | image_url: width: 120 }}"
                                            alt="{{ block.settings[title_key] }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-14 h-14 object-cover rounded shrink-0">
                                        {% else %}
                                          <div class="w-14 h-14 bg-white/20 rounded shrink-0 flex items-center justify-center" style="color: var(--gogreek-dropdown-text);">
                                            <svg
                                              class="w-6 h-6"
                                              fill="none"
                                              stroke="currentColor"
                                              viewBox="0 0 24 24"><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                          </div>
                                        {% endif %}
                                        <span class="gogreek-dropdown-link text-sm" style="color: var(--gogreek-dropdown-text);">{{ block.settings[title_key] }}</span>
                                      </a>
                                    {% endif %}
                                  {% endfor %}
                                </div>

                              {% when 'product_grid_menu' %}
                                <!-- Product Grid Layout (School Org) -->
                                <div class="grid gap-6" style="grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));">
                                  {% for i in (1..6) %}
                                    {% assign img_key = 'item' | append: i | append: '_image' %}
                                    {% assign title_key = 'item' | append: i | append: '_title' %}
                                    {% assign url_key = 'item' | append: i | append: '_url' %}
                                    {% if block.settings[title_key] != blank %}
                                      <a href="{{ block.settings[url_key] | default: '#' }}" class="flex items-center gap-4 group hover:opacity-80 transition-opacity">
                                        {% if block.settings[img_key] != blank %}
                                          <img
                                            src="{{ block.settings[img_key] | image_url: width: 200 }}"
                                            alt="{{ block.settings[title_key] }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-20 h-20 object-cover rounded shrink-0">
                                        {% else %}
                                          <div class="w-20 h-20 bg-white/20 rounded shrink-0 flex items-center justify-center" style="color: var(--gogreek-dropdown-text);">
                                            <svg
                                              class="w-8 h-8"
                                              fill="none"
                                              stroke="currentColor"
                                              viewBox="0 0 24 24"><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                          </div>
                                        {% endif %}
                                        <span class="gogreek-dropdown-link text-sm" style="color: var(--gogreek-dropdown-text);">{{ block.settings[title_key] }}</span>
                                      </a>
                                    {% endif %}
                                  {% endfor %}
                                </div>
                            {% endcase %}

                          {% endif %}
                        {% endfor %}

                        <!-- Custom Apparel Button -->
                        {% if section.settings.show_custom_apparel %}
                          <div class="mt-6 pt-4">
                            <a
                              href="{{ section.settings.custom_apparel_url | default: '#' }}"
                              class="inline-block px-6 py-2 border-2 text-sm font-medium uppercase tracking-wider transition-colors hover:bg-white hover:text-gray-900"
                              style="border-color: var(--gogreek-dropdown-text); color: var(--gogreek-dropdown-text);">
                              {{ section.settings.custom_apparel_text | default: 'Custom Apparel' }}
                            </a>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </nav>
  </header>

  <!-- Mobile Menu -->
  <div
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    x-cloak
    class="lg:hidden fixed inset-0 z-50"
    style="background-color: var(--gogreek-header-bg);">

    <!-- Mobile Header -->
    <div class="flex items-center justify-between p-4 border-b border-gray-700">
      <button @click="mobileMenuOpen = false" style="color: var(--gogreek-header-text);">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          height="inherit"
          width="inherit"
          style="width: {{ section.settings.logo_width | times: 0.7 }}px;"
          class="h-auto">
      {% endif %}

      <div class="w-6"></div>
    </div>

    <!-- Mobile Menu Items -->
    <div class="py-4 overflow-y-auto h-[calc(100vh-80px)]">
      {% if section.settings.main_menu != blank %}
        {% for link in linklists[section.settings.main_menu].links %}
          <a
            href="{{ link.url }}"
            class="block px-6 py-4 text-base uppercase tracking-wider border-b border-gray-800"
            style="color: var(--gogreek-header-text);">
            {{ link.title }}
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>