{% style %}
  :root  {
    --gogreek-header-bg: {{ section.settings.header_bg }};
    --gogreek-header-text: {{ section.settings.header_text }};
    --gogreek-nav-bg: {{ section.settings.nav_bg }};
    --gogreek-nav-text: {{ section.settings.nav_text }};
    --gogreek-dropdown-bg: {{ section.settings.dropdown_bg }};
    --gogreek-dropdown-text: {{ section.settings.dropdown_text }};
    --gogreek-announcement-bg: {{ section.settings.announcement_bg }};
    --gogreek-announcement-text: {{ section.settings.announcement_text_color }};
  }

  [x-cloak] {
    display: none !important;
  }

  .gogreek-nav-link {
    position: relative;
  }

  .gogreek-nav-link::after {
    content: '';
    position: absolute;
    bottom: 12px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--gogreek-nav-text);
    transition: width 0.2s ease;
  }

  .gogreek-nav-link:hover::after,
  .gogreek-nav-link.active::after {
    width: 100%;
  }

  .gogreek-dropdown {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Dropdown link underline hover effect */
  .gogreek-dropdown-link {
    position: relative;
    display: inline-block;
  }

  .gogreek-dropdown-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.2s ease;
  }

  .gogreek-dropdown-link:hover::after {
    width: 100%;
  }
{% endstyle %}

<div
  x-data="{ mobileMenuOpen: false, openDropdown: null, navBottom: 0 }"
  x-init="$nextTick(() => { const nav = $el.querySelector('nav'); if(nav) navBottom = nav.getBoundingClientRect().bottom; })"
  @resize.window="const nav = $el.querySelector('nav'); if(nav) navBottom = nav.getBoundingClientRect().bottom;"
  class="w-full relative z-50"
  style="font-family: 'Inter', sans-serif;">

  <!-- Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="w-full py-2 px-4 flex items-center justify-between text-xs" style="background-color: var(--gogreek-announcement-bg); color: var(--gogreek-announcement-text);">

      <!-- Left: Announcement Text -->
      <div class="flex-1 text-center lg:text-left">
        {{ section.settings.announcement_text }}
      </div>

      <!-- Right: Social Icons -->
