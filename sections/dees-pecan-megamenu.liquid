{% comment %} 
                                                                                  Dees Pecan Megamenu
                                                                                  A megamenu section matching the Dees Pecan design with: 
                                                                                  - Dark header with logo, search, cart/account 
                                                                                  - Navigation with Products dropdown 
                                                                                  - Dropdown shows links on left, image on right 
{% endcomment %}

<style>
  .dees-pecan-megamenu {
    --header-bg: {{ section.settings.header_bg }};
    --header-text: {{ section.settings.header_text }};
    --accent-color: {{ section.settings.accent_color }};
    --dropdown-bg: {{ section.settings.dropdown_bg }};
  }

  /* Dropdown animation */
  .dees-dropdown {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease-out;
  }

  .dees-nav-item:hover .dees-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Search input styling */
  .dees-search-input {
    background-color: #BFBFBF;
    border: none;
    color: white;
    font-size: 12px;
  }

  .dees-search-input::placeholder {
    color: rgba(255, 255, 255, 0.9);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 12px;
  }

  .dees-search-input:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
  }

  /* Dropdown links container */
  .dees-dropdown-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Each dropdown link with underline below */
  .dees-dropdown-link {
    display: inline-block;
    position: relative;
    padding: 12px 10px 12px 0;
    font-size: 14px;
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0.01em;
    text-decoration: none;
    line-height: 1.3;
    color: rgba(51, 51, 51, 0.7);
    transition: color 0.2s ease;
  }

  /* Underline beneath each link - extends past text */
  .dees-dropdown-link::after {
    content: '';
    position: absolute;
    left: -8px;
    bottom: 8px;
    width: calc(100% + 16px);
    height: 1px;
    background-color: rgba(51, 51, 51, 0.35);
    transition: background-color 0.2s ease
    , height 0.2s ease;
  }


  /* Hover and active state - white text, golden underline */
  .dees-dropdown-link:hover,
  .dees-dropdown-link.active {
    color: white !important;
  }

  .dees-dropdown-link:hover::after,
  .dees-dropdown-link.active::after {
    background-color: var(--accent-color);
    height: 2px;
  }

  /* Mobile drawer */
  .dees-mobile-overlay {
    transition: opacity 0.3s ease-out;
  }

  .dees-mobile-drawer {
    transition: transform 0.3s ease-out;
  }

  [x-cloak] {
    display: none !important;
  }
</style>

<div class="dees-pecan-megamenu" x-data="{ mobileOpen: false, searchOpen: false }">

  {% comment %} ===== MAIN HEADER ===== {% endcomment %}
  <header class="w-full" style="background-color: var(--header-bg);">
    <div class="w-full px-6">

      <!-- Desktop: Logo LEFT | Right column with Search/Icons + Nav -->
      <div class="hidden lg:flex items-stretch justify-between py-4 w-full">

        <!-- Logo (Left edge - no left padding) -->
        <a href="{{ routes.root_url }}" class="shrink-0 flex items-center">
          {% if section.settings.logo %}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              class="h-auto"
              height="inherit"
              width="inherit"
              style="width: {{ section.settings.logo_width }}px;"
              loading="eager">
          {% else %}
            <span class="text-2xl font-bold" style="color: var(--header-text);">{{ shop.name }}</span>
          {% endif %}
        </a>

        <!-- Right Column: Two rows stacked (right edge - no right padding) -->
        <div class="flex flex-col justify-between">

          <!-- Top Row: Search + Cart + Account (right aligned) -->
          <div class="flex items-center justify-end gap-4 pb-3">

            <!-- Search Bar -->
            <form
              action="{{ routes.search_url }}"
              method="get"
              class="relative">
              <input
                type="search"
                name="q"
                placeholder="SEARCH"
                class="dees-search-input w-48 pl-10 pr-4 py-2 text-base uppercase tracking-widest">
              <svg
                class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </form>

            <!-- Cart -->
            <a
              href="{{ routes.cart_url }}"
              class="p-1 relative"
              style="color: var(--header-text);">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              {% if cart.item_count > 0 %}
                <span class="absolute -top-1 -right-1 w-4 h-4 text-xs flex items-center justify-center rounded-full" style="background-color: var(--accent-color); color: var(--header-bg);">
                  {{ cart.item_count }}
                </span>
              {% endif %}
            </a>

            <!-- Account -->
            <a
              href="{{ routes.account_url }}"
              class="p-1"
              style="color: var(--header-text);">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </a>
          </div>

          <!-- Bottom Row: Navigation (right aligned) -->
          <nav class="flex items-center justify-end gap-10">
            {% for link in linklists[section.settings.main_menu].links %}
              {% assign link_title_lower = link.title | downcase | strip %}
              {% assign has_dropdown = false %}

              {% comment %} Check if this link has dropdown blocks {% endcomment %}
              {% for block in section.blocks %}
                {% if block.type == 'menu_group' %}
                  {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                  {% if block_parent == link_title_lower %}
                    {% assign has_dropdown = true %}
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}

              {% if has_dropdown %}
                <div class="dees-nav-item relative group">
                  <a
                    href="{{ link.url }}"
                    class="flex items-center gap-1 text-sm font-medium uppercase tracking-wider transition-colors hover:opacity-80"
                    style="color: var(--header-text);"
                    onclick="event.preventDefault();">
                    {{ link.title }}
                    <svg
                      class="w-3 h-3"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>

                  <!-- Dropdown (centered beneath link) -->
                  <div class="dees-dropdown absolute left-1/2 -translate-x-1/2 top-full pt-2 z-50">
                    {% for block in section.blocks %}
                      {% if block.type == 'menu_group' %}
                        {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                        {% if block_parent == link_title_lower %}
                          <div
                            class="flex gap-0 shadow-2xl overflow-hidden"
                            style="min-width: 700px;"
                            x-data="{ activeImage: 1 }">

                            <!-- Links Section -->
                            <div class="flex-1 py-5 px-6" style="background-color: var(--dropdown-bg);">
                              <div class="dees-dropdown-links">
                                {% for i in (1..8) %}
                                  {% assign title_key = 'item' | append: i | append: '_title' %}
                                  {% assign url_key = 'item' | append: i | append: '_url' %}
                                  {% assign title = block.settings[title_key] %}
                                  {% if title != blank %}
                                    <a
                                      href="{{ block.settings[url_key] | default: '#' }}"
                                      class="dees-dropdown-link"
                                      :class="activeImage === {{ i }} ? 'active' : ''"
                                      style="color: var(--header-bg);"
                                      @mouseenter="activeImage = {{ i }}">
                                      {{ title }}
                                    </a>
                                  {% endif %}
                                {% endfor %}
                              </div>
                            </div>

                            <!-- Image Section -->
                            <div class="flex-1 relative overflow-hidden" style="min-height: 340px; background-color: var(--dropdown-bg);">
                              {% for i in (1..8) %}
                                {% assign image_key = 'item' | append: i | append: '_image' %}
                                {% assign title_key = 'item' | append: i | append: '_title' %}
                                {% if block.settings[image_key] and block.settings[title_key] != blank %}
                                  <img
                                    src="{{ block.settings[image_key] | image_url: width: 600 }}"
                                    alt="{{ block.settings[title_key] }}"
                                    height="inherit"
                                    width="inherit"
                                    class="absolute inset-0 w-full h-full object-cover transition-all duration-300 hover:scale-105"
                                    :class="activeImage === {{ i }} ? 'opacity-100' : 'opacity-0'"
                                    loading="lazy">
                                {% endif %}
                              {% endfor %}
                            </div>
                          </div>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <a
                  href="{{ link.url }}"
                  class="text-sm font-medium uppercase tracking-wider transition-colors hover:opacity-80"
                  style="color: var(--header-text);">
                  {{ link.title }}
                </a>
              {% endif %}
            {% endfor %}
          </nav>
        </div>
      </div>

      <!-- Mobile Header -->
      <div class="lg:hidden flex items-center justify-between py-7 relative">
        <!-- Hamburger Menu (Left) - animates to X -->
        <button
          @click="mobileOpen = !mobileOpen"
          class="p-2 relative w-8 h-8 overflow-visible"
          style="color: var(--header-text);">
          <span class="absolute left-1 top-1 w-6 h-0.5 bg-current transition-all duration-300 origin-center" :class="mobileOpen ? 'rotate-45 top-3' : ''"></span>
          <span class="absolute left-1 top-3 w-6 h-0.5 bg-current transition-all duration-300" :class="mobileOpen ? 'opacity-0' : ''"></span>
          <span class="absolute left-1 top-5 w-6 h-0.5 bg-current transition-all duration-300 origin-center" :class="mobileOpen ? '-rotate-45 top-3' : ''"></span>
        </button>

        <!-- Logo (Center - Absolute) -->
        <a href="{{ routes.root_url }}" class="absolute left-1/2 -translate-x-1/2">
          {% if section.settings.logo %}
            <img
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name }}"
              class="h-auto"
              height="inherit"
              width="inherit"
              style="width: {{ section.settings.logo_width | times: 0.7 }}px;"
              loading="eager">
          {% else %}
            <span class="text-xl font-bold" style="color: var(--header-text);">{{ shop.name }}</span>
          {% endif %}
        </a>

        <!-- Icons (Right) -->
        <div class="flex items-center gap-3">
          <!-- Search -->
          <button
            @click="searchOpen = !searchOpen"
            class="p-1"
            style="color: var(--header-text);">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>

          <!-- Cart -->
          <a
            href="{{ routes.cart_url }}"
            class="p-1 relative"
            style="color: var(--header-text);">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            {% if cart.item_count > 0 %}
              <span class="absolute -top-1 -right-1 w-4 h-4 text-xs flex items-center justify-center rounded-full" style="background-color: var(--accent-color); color: var(--header-bg);">
                {{ cart.item_count }}
              </span>
            {% endif %}
          </a>
        </div>
      </div>
    </div>
    <div
      x-show="searchOpen"
      x-transition
      class="lg:hidden px-4 py-3 border-t border-gray-700">
      <form
        action="{{ routes.search_url }}"
        method="get"
        class="relative">
        <input
          type="search"
          name="q"
          placeholder="Search..."
          class="dees-search-input w-full pl-10 pr-4 py-2.5 rounded text-sm">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </form>
    </div>
  </header>

  {% comment %} ===== MOBILE NAVIGATION ===== {% endcomment %}
  <!-- Overlay -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="mobileOpen = false"
    class="lg:hidden fixed left-0 right-0 bottom-0"
    style="top: 90px; background-color: rgba(0,0,0,0.5); z-index: 9997;"
    x-cloak></div>

  <!-- Mobile Navigation (slides in from left, below header) -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    @keydown.escape.window="mobileOpen = false"
    class="lg:hidden fixed left-0 right-0 bottom-0 overflow-hidden"
    style="top: 90px; background-color: #000000; z-index: 9998;"
    x-data="{ showSubmenu: false }"
    x-cloak>

    <!-- Main Menu View -->
    <div class="h-full py-2 flex flex-col transition-transform duration-300" :class="showSubmenu ? '-translate-x-full' : 'translate-x-0'">

      <!-- Mobile Menu Items -->
      <div class="flex-1 overflow-y-auto">
        {% for link in linklists[section.settings.main_menu].links %}
          {% assign link_title_lower = link.title | downcase | strip %}
          {% assign has_dropdown = false %}

          {% for block in section.blocks %}
            {% if block.type == 'menu_group' %}
              {% assign block_parent = block.settings.parent_menu | downcase | strip %}
              {% if block_parent == link_title_lower %}
                {% assign has_dropdown = true %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if has_dropdown %}
            <button
              @click="showSubmenu = true"
              class="w-full flex items-center justify-between px-6 py-4 text-left transition-colors hover:bg-gray-800"
              style="color: rgba(255,255,255,0.85);">
              <span class="text-lg font-normal capitalize">{{ link.title }}</span>
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7" />
              </svg>
            </button>
          {% else %}
            {% assign is_active = false %}
            {% if link.url == request.path %}
              {% assign is_active = true %}
            {% endif %}
            <a
              href="{{ link.url }}"
              class="block px-6 py-4 text-lg capitalize transition-colors hover:bg-gray-800{% if is_active %} font-semibold{% endif %}"
              style="color: {% if is_active %}#ffffff{% else %}rgba(255,255,255,0.85){% endif %};">
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Footer with social icons and login (30% of area) -->
      <div class="px-6 py-8 flex items-center justify-between" style="border-top: 1px solid rgba(255,255,255,0.1); background-color: #141414; min-height: 30%;">
        <!-- Social Icons -->
        <div class="flex items-center gap-4">
          <a href="#" class="text-white opacity-80 hover:opacity-100 transition-opacity">
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
          <a href="#" class="text-white opacity-80 hover:opacity-100 transition-opacity">
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>

        <!-- Log in -->
        <a href="{{ routes.account_url }}" class="flex items-center gap-2 text-white opacity-80 hover:opacity-100 transition-opacity">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="text-sm">Log in</span>
        </a>
      </div>
    </div>

    <!-- Submenu View (Products) -->
    <div
      class="absolute inset-0 h-full flex flex-col transition-transform duration-300"
      style="background-color: #000000;"
      :class="showSubmenu ? 'translate-x-0' : 'translate-x-full'">

      <!-- Submenu Header -->
      <div class="px-6 py-6" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
        <button
          @click="showSubmenu = false"
          class="flex items-center gap-2 transition-colors"
          style="color: rgba(255,255,255,0.85);">
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7" />
          </svg>
          <span class="text-lg">Products</span>
        </button>
      </div>

      <!-- Submenu Items -->
      <div class="flex-1 py-4 overflow-y-auto ">
        {% for block in section.blocks %}
          {% if block.type == 'menu_group' %}
            {% assign block_parent = block.settings.parent_menu | downcase | strip %}
            {% if block_parent == 'products' %}
              {% for i in (1..8) %}
                {% assign title_key = 'item' | append: i | append: '_title' %}
                {% assign url_key = 'item' | append: i | append: '_url' %}
                {% assign title = block.settings[title_key] %}
                {% if title != blank %}
                  <a
                    href="{{ block.settings[url_key] | default: '#' }}"
                    class="block px-6 py-4 text-base lowercase transition-colors hover:bg-gray-800"
                    style="color: rgba(255,255,255,0.7);">
                    {{ title }}
                  </a>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Dees Pecan Megamenu",
    "tag": "section",
    "class": "dees-pecan-megamenu-section",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 250,
        "step": 10,
        "default": 100,
        "unit": "px"
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "header_bg",
        "label": "Header background",
        "default": "#1a1a1a"
      }, {
        "type": "color",
        "id": "header_text",
        "label": "Header text",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color (search bar)",
        "default": "#b8860b"
      }, {
        "type": "color",
        "id": "dropdown_bg",
        "label": "Dropdown background",
        "default": "#7B4A00"
      }
    ],
    "blocks": [
      {
        "type": "menu_group",
        "name": "Menu Group",
        "settings": [
          {
            "type": "text",
            "id": "parent_menu",
            "label": "Parent menu item",
            "info": "Enter the exact title of the parent menu item (e.g., 'Products')"
          },
          {
            "type": "header",
            "content": "Link 1"
          },
          {
            "type": "text",
            "id": "item1_title",
            "label": "Title"
          },
