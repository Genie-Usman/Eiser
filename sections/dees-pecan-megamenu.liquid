{% comment %} 
  Dees Pecan Megamenu
  A megamenu section matching the Dees Pecan design with: 
  - Dark header with logo, search, cart/account 
  - Navigation with Products dropdown 
  - Dropdown shows links on left, image on right 
{% endcomment %}

<style>
  .dees-pecan-megamenu {
    --header-bg: {{ section.settings.header_bg }};
    --header-text: {{ section.settings.header_text }};
    --accent-color: {{ section.settings.accent_color }};
    --dropdown-bg: {{ section.settings.dropdown_bg }};
  }

  /* Dropdown animation */
  .dees-dropdown {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease-out;
  }

  .dees-nav-item:hover .dees-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Search input styling */
  .dees-search-input {
    background-color: var(--accent-color);
    border: none;
    color: white;
  }

  .dees-search-input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .dees-search-input:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.3);
  }

  /* Mobile drawer */
  .dees-mobile-overlay {
    transition: opacity 0.3s ease-out;
  }

  .dees-mobile-drawer {
    transition: transform 0.3s ease-out;
  }

  [x-cloak] {
    display: none !important;
  }
</style>

<div class="dees-pecan-megamenu" x-data="{ mobileOpen: false, searchOpen: false }">

  {% comment %} ===== MAIN HEADER ===== {% endcomment %}
  <header class="w-full" style="background-color: var(--header-bg);">
    <div class="mx-auto px-4 lg:px-8" style="max-width: 1400px;">

      <!-- Single Row: Logo LEFT | Search + Icons RIGHT -->
      <div class="flex items-center justify-between py-4">

        <!-- Logo (Left) -->
        <a href="{{ routes.root_url }}" class="shrink-0">
          {% if section.settings.logo %}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              class="h-auto"
              height="inherit"
              width="inherit"
              style="width: {{ section.settings.logo_width }}px;"
              loading="eager">
          {% else %}
            <span class="text-2xl font-bold" style="color: var(--header-text);">{{ shop.name }}</span>
          {% endif %}
        </a>

        <!-- Right Side: Search + Nav + Icons -->
        <div class="flex items-center gap-6">
          
          <!-- Search Bar (Desktop) -->
          <div class="hidden lg:flex items-center">
            <form action="{{ routes.search_url }}" method="get" class="relative">
              <input
                type="search"
                name="q"
                placeholder="SEARCH"
                class="dees-search-input w-48 pl-10 pr-4 py-2 rounded text-sm uppercase tracking-wider">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </form>
          </div>

          <!-- Cart -->
          <a href="{{ routes.cart_url }}" class="p-1 relative" style="color: var(--header-text);">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            {% if cart.item_count > 0 %}
              <span class="absolute -top-1 -right-1 w-4 h-4 text-xs flex items-center justify-center rounded-full" style="background-color: var(--accent-color); color: var(--header-bg);">
                {{ cart.item_count }}
              </span>
            {% endif %}
          </a>

          <!-- Account -->
          <a href="{{ routes.account_url }}" class="p-1" style="color: var(--header-text);">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </a>

          <!-- Mobile Menu Button -->
          <button @click="mobileOpen = true" class="lg:hidden p-1" style="color: var(--header-text);">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Navigation Row (Desktop) - Right Aligned -->
      <nav class="hidden lg:flex items-center justify-end gap-8 py-3 border-t border-gray-700">
        {% for link in linklists[section.settings.main_menu].links %}
          {% assign link_title_lower = link.title | downcase | strip %}
          {% assign has_dropdown = false %}

          {% comment %} Check if this link has dropdown blocks {% endcomment %}
          {% for block in section.blocks %}
            {% if block.type == 'dropdown_link' or block.type == 'dropdown_image' %}
              {% assign block_parent = block.settings.parent_menu | downcase | strip %}
              {% if block_parent == link_title_lower %}
                {% assign has_dropdown = true %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if has_dropdown %}
            <div class="dees-nav-item relative group">
              <a
                href="{{ link.url }}"
                class="flex items-center gap-1 text-sm font-medium uppercase tracking-wider transition-colors hover:opacity-80"
                style="color: var(--header-text);"
                onclick="event.preventDefault();">
                {{ link.title }}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <!-- Dropdown -->
              <div class="dees-dropdown absolute left-0 top-full pt-4 z-50">
                <div class="flex shadow-2xl overflow-hidden" style="min-width: 600px;">

                  <!-- Links Section -->
                  <div class="w-2/5 py-6 px-6" style="background-color: var(--dropdown-bg);">
                    {% for block in section.blocks %}
                      {% if block.type == 'dropdown_link' %}
                        {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                        {% if block_parent == link_title_lower %}
                          <a
                            href="{{ block.settings.link_url | default: '#' }}"
                            class="block py-3 text-sm border-b border-gray-600 last:border-0 transition-colors hover:opacity-80"
                            style="color: var(--header-bg);">
                            {{ block.settings.link_title }}
                          </a>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>

                  <!-- Image Section -->
                  <div class="w-3/5">
                    {% for block in section.blocks %}
                      {% if block.type == 'dropdown_image' %}
                        {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                        {% if block_parent == link_title_lower and block.settings.image %}
                          <img
                            src="{{ block.settings.image | image_url: width: 600 }}"
                            alt="{{ link.title }}"
                            class="w-full h-full object-cover"
                            loading="lazy">
                          {% break %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            <a
              href="{{ link.url }}"
              class="text-sm font-medium uppercase tracking-wider transition-colors hover:opacity-80"
              style="color: var(--header-text);">
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>

    <!-- Mobile Search (Expandable) -->
    <div
      x-show="searchOpen"
      x-transition
      class="lg:hidden px-4 py-3 border-t border-gray-700">
      <form
        action="{{ routes.search_url }}"
        method="get"
        class="relative">
        <input
          type="search"
          name="q"
          placeholder="Search..."
          class="dees-search-input w-full pl-10 pr-4 py-2.5 rounded text-sm">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </form>
    </div>
  </header>

  {% comment %} ===== MOBILE NAVIGATION ===== {% endcomment %}
  <!-- Overlay -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="mobileOpen = false"
    class="dees-mobile-overlay fixed inset-0 bg-black/50 z-[9998]"
    x-cloak></div>

  <!-- Drawer -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    @keydown.escape.window="mobileOpen = false"
    class="dees-mobile-drawer fixed left-0 top-0 h-full w-full bg-white z-[9999] overflow-y-auto"
    x-cloak>

    <!-- Drawer Header -->
    <div class="flex items-center justify-between p-4 border-b" style="background-color: var(--header-bg);">
      <button
        @click="mobileOpen = false"
        class="p-2"
        style="color: var(--header-text);">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          class="h-auto"
          style="width: {{ section.settings.logo_width | times: 0.7 }}px;">
      {% endif %}

      <div class="w-10"></div>
    </div>

    <!-- Mobile Menu Items -->
    <div class="py-4">
      {% for link in linklists[section.settings.main_menu].links %}
        {% assign link_title_lower = link.title | downcase | strip %}
        {% assign has_dropdown = false %}

        {% for block in section.blocks %}
          {% if block.type == 'dropdown_link' %}
            {% assign block_parent = block.settings.parent_menu | downcase | strip %}
            {% if block_parent == link_title_lower %}
              {% assign has_dropdown = true %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if has_dropdown %}
          <div x-data="{ open: false }">
            <button @click="open = !open" class="w-full flex items-center justify-between px-5 py-4 text-left hover:bg-gray-50">
              <span class="text-base font-medium text-gray-800 uppercase">{{ link.title }}</span>
              <svg
                class="w-4 h-4 text-gray-400 transition-transform duration-200"
                :class="{ 'rotate-180': open }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              x-show="open"
              x-transition
              class="bg-gray-50 py-2">
              {% for block in section.blocks %}
                {% if block.type == 'dropdown_link' %}
                  {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                  {% if block_parent == link_title_lower %}
                    <a href="{{ block.settings.link_url | default: '#' }}" class="block px-8 py-3 text-sm text-gray-700 hover:text-gray-900">
                      {{ block.settings.link_title }}
                    </a>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ link.url }}" class="block px-5 py-4 text-base font-medium text-gray-800 uppercase hover:bg-gray-50">
            {{ link.title }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Dees Pecan Megamenu",
    "tag": "section",
    "class": "dees-pecan-megamenu-section",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 250,
        "step": 10,
        "default": 100,
        "unit": "px"
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "header_bg",
        "label": "Header background",
        "default": "#1a1a1a"
      }, {
        "type": "color",
        "id": "header_text",
        "label": "Header text",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color (search bar)",
        "default": "#b8860b"
      }, {
        "type": "color",
        "id": "dropdown_bg",
        "label": "Dropdown background",
        "default": "#c9a227"
      }
    ],
    "blocks": [
      {
        "type": "dropdown_link",
        "name": "Dropdown Link",
        "settings": [
          {
            "type": "text",
            "id": "parent_menu",
            "label": "Parent menu item",
            "info": "Enter the exact title of the parent menu item (e.g., 'Products')"
          }, {
            "type": "text",
            "id": "link_title",
            "label": "Link title",
            "default": "Menu Item"
          }, {
            "type": "url",
            "id": "link_url",
            "label": "Link URL"
          }
        ]
      }, {
        "type": "dropdown_image",
        "name": "Dropdown Image",
        "settings": [
          {
            "type": "text",
            "id": "parent_menu",
            "label": "Parent menu item",
            "info": "Enter the exact title of the parent menu item (e.g., 'Products')"
          }, {
            "type": "image_picker",
            "id": "image",
            "label": "Featured image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Dees Pecan Megamenu"
      }
    ]
  }
{% endschema %}