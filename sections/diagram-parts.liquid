{% comment %} 
  Diagram Parts Table
  Displays the diagram image with a parts table below.
  This section is meant to be used in a metaobject template for "diagram_page".
   
  Metaobjects required: 
  - diagram_page: title, image, system_category, type_parent 
  - part_entry: pos, part_number, description, price, diagram_parent (ref to diagram_page) 
{% endcomment %}

<style>
  .diagram-parts {
    padding: 60px 0;
    background-color: {{ section.settings.background_color }};
  }

  .diagram-parts-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .diagram-parts__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 30px;
    color: {{ section.settings.accent_color }};
    text-decoration: none;
    font-weight: 500;
  }

  .diagram-parts__back:hover {
    text-decoration: underline;
  }

  .diagram-parts__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .diagram-parts__title {
    font-size: 2rem;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px;
  }

  .diagram-parts__category {
    font-size: 1rem;
    color: #666;
  }

  .diagram-parts__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .diagram-parts__image-wrapper {
    background: #fff;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 20px;
  }

  .diagram-parts__image {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .diagram-parts__table-wrapper {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .diagram-parts__table-header {
    padding: 20px;
    border-bottom: 1px solid #eee;
  }

  .diagram-parts__table-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
  }

  .parts-table {
    width: 100%;
    border-collapse: collapse;
  }

  .parts-table thead {
    background: #f9f9f9;
  }

  .parts-table th {
    padding: 15px;
    text-align: left;
    font-weight: 600;
    font-size: 0.9rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #eee;
  }

  .parts-table td {
    padding: 15px;
    border-bottom: 1px solid #eee;
    font-size: 0.95rem;
    color: #333;
  }

  .parts-table tbody tr:hover {
    background: #f9f9f9;
  }

  .parts-table tbody tr:last-child td {
    border-bottom: none;
  }

  .parts-table__pos {
    font-weight: 600;
    color: {{ section.settings.accent_color }};
    width: 60px;
  }

  .parts-table__part-number {
    font-family: monospace;
    font-size: 0.9rem;
    width: 120px;
  }

  .parts-table__price {
    font-weight: 600;
    color: #1a1a1a;
    width: 100px;
  }

  .parts-empty {
    padding: 40px;
    text-align: center;
    color: #888;
  }

  @media (max-width: 992px) {
    .diagram-parts__layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .diagram-parts__image-wrapper {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 768px) {
    .diagram-parts {
      padding: 40px 0;
    }

    .diagram-parts__title {
      font-size: 1.5rem;
    }

    .parts-table th,
    .parts-table td {
      padding: 12px 10px;
      font-size: 0.85rem;
    }

    .parts-table {
      display: block;
      overflow-x: auto;
    }
  }
</style>

<section class="diagram-parts">
  <div class="diagram-parts-container">
    {% if metaobject.type_parent != blank %}
      <a href="{{ metaobject.type_parent.value.system.url }}" class="diagram-parts__back">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Back to Diagrams
      </a>
    {% endif %}

    <div class="diagram-parts__header">
      {% if metaobject != blank %}
        <h1 class="diagram-parts__title">{{ metaobject.title.value }}</h1>
        {% if metaobject.system_category.value != blank %}
          <p class="diagram-parts__category">{{ metaobject.system_category.value }}</p>
        {% endif %}
      {% else %}
        <h1 class="diagram-parts__title">{{ section.settings.heading }}</h1>
      {% endif %}
    </div>

    <div class="diagram-parts__layout">
      {% comment %} Diagram Image {% endcomment %}
      <div class="diagram-parts__image-wrapper">
        {% if metaobject.image.value != blank %}
          <img
            src="{{ metaobject.image.value | image_url: width: 1000 }}"
            alt="{{ metaobject.title.value | escape }}"
            class="diagram-parts__image">
        {% else %}
          <div style="padding: 60px; text-align: center; color: #888;">
            No diagram image available
          </div>
        {% endif %}
      </div>

      {% comment %} Parts Table {% endcomment %}
      <div class="diagram-parts__table-wrapper">
        <div class="diagram-parts__table-header">
          <h2 class="diagram-parts__table-title">Parts List</h2>
        </div>

        {% assign all_parts = shop.metaobjects.part_entry.values %}
        {% assign current_parts = '' | split: '' %}

        {% for part in all_parts %}
          {% if metaobject != blank and part.diagram_parent.value.id == metaobject.id %}
            {% assign current_parts = current_parts | push: part %}
          {% endif %}
        {% endfor %}

        {% if current_parts.size > 0 %}
          <table class="parts-table">
            <thead>
              <tr>
                <th>POS</th>
                <th>Part Number</th>
                <th>Description</th>
                {% if section.settings.show_price %}
                  <th>Price</th>
                {% endif %}
              </tr>
            </thead>
            <tbody>
              {% for part in current_parts %}
                <tr>
                  <td class="parts-table__pos">{{ part.pos.value }}</td>
                  <td class="parts-table__part-number">{{ part.part_number.value }}</td>
                  <td>{{ part.description.value }}</td>
                  {% if section.settings.show_price %}
                    <td class="parts-table__price">
                      {% if part.price.value != blank %}
                        {{ part.price.value | money }}
                      {% else %}
                        -
                      {% endif %}
                    </td>
                  {% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="parts-empty">
            <p>No parts found for this diagram.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Diagram Parts Table",
    "tag": "section",
    "class": "diagram-parts-wrapper",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Diagram",
        "info": "Used when not on a metaobject page"
      },
      {
        "type": "checkbox",
        "id": "show_price",
        "label": "Show Price Column",
        "default": true
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#f5f5f5"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#1a1a1a"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent Color",
        "default": "#a52a2a"
      }
    ],
    "presets": [
      {
        "name": "Diagram Parts Table"
      }
    ]
  }
{% endschema %}