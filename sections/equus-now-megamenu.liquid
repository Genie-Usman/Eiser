{% schema %}
  {
    "name": "Equus Now Megamenu",
    "settings": [
      {
        "type": "header",
        "content": "Header Settings"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 250,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 120
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main Menu",
        "default": "main-menu",
        "info": "Select 'equus-now-menu' from your Shopify admin"
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "header_bg",
        "label": "Header Background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "header_text",
        "label": "Header Text Color",
        "default": "#333333"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent Color (Active/Hover)",
        "default": "#40bfb0"
      }, {
        "type": "color",
        "id": "dropdown_bg",
        "label": "Dropdown Background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "sidebar_bg",
        "label": "Left Sidebar Background",
        "default": "#f5f5f5"
      }
    ],
    "blocks": [
      {
        "type": "menu_dropdown",
        "name": "Menu Dropdown Config",
        "settings": [
          {
            "type": "text",
            "id": "menu_title",
            "label": "Parent Menu Title (Exact Match)",
            "info": "e.g. 'For The Horse'"
          },
          {
            "type": "header",
            "content": "Featured Image (Right Side)"
          },
          {
            "type": "image_picker",
            "id": "featured_image",
            "label": "Featured Image"
          },
          {
            "type": "text",
            "id": "featured_title",
            "label": "Featured Image Title",
            "default": "Featured Product"
          }, {
            "type": "url",
            "id": "featured_link",
            "label": "Featured Image Link"
          }, {
            "type": "header",
            "content": "Column 1"
          }, {
            "type": "text",
            "id": "col1_title",
            "label": "Column 1 Title"
          }, {
            "type": "textarea",
            "id": "col1_links",
            "label": "Column 1 Links",
            "info": "One link per line: Link Text|URL"
          }, {
            "type": "header",
            "content": "Column 2"
          }, {
            "type": "text",
            "id": "col2_title",
            "label": "Column 2 Title"
          }, {
            "type": "textarea",
            "id": "col2_links",
            "label": "Column 2 Links",
            "info": "One link per line: Link Text|URL"
          }, {
            "type": "header",
            "content": "Column 3"
          }, {
            "type": "text",
            "id": "col3_title",
            "label": "Column 3 Title"
          }, {
            "type": "textarea",
            "id": "col3_links",
            "label": "Column 3 Links",
            "info": "One link per line: Link Text|URL"
          }, {
            "type": "header",
            "content": "Column 4"
          }, {
            "type": "text",
            "id": "col4_title",
            "label": "Column 4 Title"
          }, {
            "type": "textarea",
            "id": "col4_links",
            "label": "Column 4 Links",
            "info": "One link per line: Link Text|URL"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Equus Now Megamenu"
      }
    ]
  }
{% endschema %}

{% style %}
  :root  {
    --equus-header-bg: {{ section.settings.header_bg }};
    --equus-header-text: {{ section.settings.header_text }};
    --equus-accent: {{ section.settings.accent_color }};
    --equus-dropdown-bg: {{ section.settings.dropdown_bg }};
    --equus-sidebar-bg: {{ section.settings.sidebar_bg }};
  }
{% endstyle %}

<div
  x-data="{ mobileMenuOpen: false }"
  class="w-full relative z-40 font-sans"
  style="font-family: 'Inter', sans-serif;">

  <!-- Header -->
  <header class="w-full border-b border-gray-100" style="background-color: var(--equus-header-bg);">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-8 h-[70px] flex items-center justify-between">

      <!-- Mobile Toggle -->
      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="lg:hidden p-2 hover:opacity-75"
        aria-label="Toggle Menu">
        <svg
          class="w-6 h-6"
          style="color: var(--equus-header-text);"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="flex items-center">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width | times: 2 }}"
            alt="{{ shop.name }}"
            style="width: {{ section.settings.logo_width }}px; max-height: 50px;"
            class="h-auto object-contain"
            loading="eager"
            width="{{ section.settings.logo_width }}"
            height="auto">
        {% else %}
          <span class="text-2xl font-extrabold" style="color: var(--equus-header-text);">{{ shop.name }}</span>
        {% endif %}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8 h-full">
        {% if section.settings.main_menu != blank %}
          {% for link in linklists[section.settings.main_menu].links %}
            <div
              class="relative h-full flex items-center group"
              x-data="{ open: false }"
              @mouseenter="open = true"
              @mouseleave="open = false">

              <a
                href="{{ link.url }}"
                class="flex items-center gap-1 text-[14px] font-medium transition-colors duration-200 py-2"
                style="color: var(--equus-header-text);"
                :style="open ? 'color: var(--equus-accent)' : ''"
                {% if link.links != blank %}
                onclick="event.preventDefault();"
                {% endif %}>
                {{ link.title }}
                {% if link.links != blank %}
                  <svg
                    class="w-3 h-3 transition-transform duration-200"
                    :class="{'rotate-180': open}"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7" />
                  </svg>
                {% endif %}
              </a>

              <!-- Megamenu Dropdown -->
              {% if link.links != blank %}
                <div
                  x-show="open"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 translate-y-2"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  x-transition:leave="transition ease-in duration-150"
                  x-transition:leave-start="opacity-100 translate-y-0"
                  x-transition:leave-end="opacity-0 translate-y-2"
                  x-cloak
                  class="absolute left-1/2 top-full -translate-x-1/2 w-screen bg-white shadow-xl border-t border-gray-100 z-50"
                  style="width: 100vw; left: 50%; transform: translateX(-50%); background-color: var(--equus-dropdown-bg);">

                  <div class="max-w-[1400px] mx-auto flex min-h-[350px]">

                    <!-- Left Sidebar: Child Links -->
                    <div class="w-[240px] shrink-0 py-5 border-r border-gray-100" style="background-color: var(--equus-sidebar-bg);">
                      {% for child in link.links %}
                        <a href="{{ child.url }}" class="flex items-center justify-between px-6 py-3 text-[13px] font-medium text-gray-700 hover:text-[var(--equus-accent)] hover:bg-white transition-all duration-200">
                          {{ child.title }}
                          <svg
                            class="w-3 h-3 opacity-50"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M9 5l7 7-7 7" />
                          </svg>
                        </a>
                      {% endfor %}
                  </div>

                    <!-- Center: Custom Columns from Block -->
                    {% assign block_found = false %}
                    {% assign link_title_down = link.title | downcase | strip %}

                    {% for block in section.blocks %}
                      {% if block.type == 'menu_dropdown' %}
                        {% assign block_title = block.settings.menu_title | downcase | strip %}
                          {% if block_title == link_title_down %}
                          {% assign block_found = true %}

                            <div class="flex-1 flex gap-10 py-8 px-10">
                            {% comment %} Column 1 {% endcomment %}
                            {% if block.settings.col1_title != blank %}
                              <div class="min-w-[140px]">
                                <h4 class="text-[13px] font-bold text-gray-800 mb-4">{{ block.settings.col1_title }}</h4>
                                <ul class="space-y-2.5">
                                  {% assign col1_lines = block.settings.col1_links | split: "\n" %}
                                  {% for line in col1_lines %}
                                    {% assign parts = line | split: "|" %}
                                    {% if parts.size >= 2 %}
                                      <li>
                                        <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% elsif parts.size == 1 and parts[0] != blank %}
                                      <li>
                                        <a href="#" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% endif %}
                                  {% endfor %}
                                </ul>
                              </div>
                            {% endif %}

                            {% comment %} Column 2 {% endcomment %}
                            {% if block.settings.col2_title != blank %}
                              <div class="min-w-[140px]">
                                <h4 class="text-[13px] font-bold text-gray-800 mb-4">{{ block.settings.col2_title }}</h4>
                                <ul class="space-y-2.5">
                                  {% assign col2_lines = block.settings.col2_links | split: "\n" %}
                                  {% for line in col2_lines %}
                                    {% assign parts = line | split: "|" %}
                                    {% if parts.size >= 2 %}
                                      <li>
                                        <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% elsif parts.size == 1 and parts[0] != blank %}
                                      <li>
                                        <a href="#" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% endif %}
                                  {% endfor %}
                                </ul>
                              </div>
                            {% endif %}

                            {% comment %} Column 3 {% endcomment %}
                            {% if block.settings.col3_title != blank %}
                              <div class="min-w-[140px]">
                                <h4 class="text-[13px] font-bold text-gray-800 mb-4">{{ block.settings.col3_title }}</h4>
                                <ul class="space-y-2.5">
                                  {% assign col3_lines = block.settings.col3_links | split: "\n" %}
                                  {% for line in col3_lines %}
                                    {% assign parts = line | split: "|" %}
                                    {% if parts.size >= 2 %}
                                      <li>
                                        <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% elsif parts.size == 1 and parts[0] != blank %}
                                      <li>
                                        <a href="#" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% endif %}
                                  {% endfor %}
                                </ul>
                              </div>
                            {% endif %}

                            {% comment %} Column 4 {% endcomment %}
                            {% if block.settings.col4_title != blank %}
                              <div class="min-w-[140px]">
                                <h4 class="text-[13px] font-bold text-gray-800 mb-4">{{ block.settings.col4_title }}</h4>
                                <ul class="space-y-2.5">
                                  {% assign col4_lines = block.settings.col4_links | split: "\n" %}
                                  {% for line in col4_lines %}
                                    {% assign parts = line | split: "|" %}
                                    {% if parts.size >= 2 %}
                                      <li>
                                        <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% elsif parts.size == 1 and parts[0] != blank %}
                                      <li>
                                        <a href="#" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ parts[0] | strip }}</a>
                                      </li>
                                    {% endif %}
                                  {% endfor %}
                                </ul>
                              </div>
                            {% endif %}
                          </div>

                          <!-- Featured Image -->
                          {% if block.settings.featured_image != blank %}
                            <div class="w-[220px] shrink-0 py-8 px-6 flex flex-col items-center justify-center">
                              <a href="{{ block.settings.featured_link | default: '#' }}" class="block w-full rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
                                <img
                                  src="{{ block.settings.featured_image | image_url: width: 400 }}"
                                  alt="{{ block.settings.featured_title }}"
                                  class="w-full h-auto object-cover"
                                  loading="lazy"
                                  width="180"
                                  height="auto">
                              </a>
                              {% if block.settings.featured_title != blank %}
                                <span class="mt-3 text-[13px] font-medium text-gray-700 text-center">{{ block.settings.featured_title }}</span>
                              {% endif %}
                            </div>
                          {% endif %}

                          {% break %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}

                    {% unless block_found %}
                      <!-- Default: Show grandchild links if no block config -->
                      <div class="flex-1 flex gap-10 py-8 px-10">
                        {% for child in link.links %}
                          {% if child.links != blank %}
                            <div class="min-w-[140px]">
                              <h4 class="text-[13px] font-bold text-gray-800 mb-4">{{ child.title }}</h4>
                              <ul class="space-y-2.5">
                                {% for grandchild in child.links %}
                                  <li>
                                    <a href="{{ grandchild.url }}" class="text-[13px] text-gray-600 hover:text-[var(--equus-accent)] transition-colors">{{ grandchild.title }}</a>
                                  </li>
                                {% endfor %}
                              </ul>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endunless %}

                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <span class="text-sm text-gray-500">Please select a menu in the Customizer.</span>
        {% endif %}
      </nav>

      <!-- Right Icons -->
      <div class="flex items-center gap-5">
        <a
          href="{{ routes.search_url }}"
          class="hover:opacity-75 transition-opacity"
          style="color: var(--equus-header-text);"
          aria-label="Search">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>
        {% if shop.customer_accounts_enabled %}
          <a
            href="{{ routes.account_url }}"
            class="hover:opacity-75 transition-opacity"
            style="color: var(--equus-header-text);"
            aria-label="Account">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </a>
        {% endif %}
        <a
          href="#"
          class="hover:opacity-75 transition-opacity"
          style="color: var(--equus-header-text);"
          aria-label="Wishlist">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </a>
        <a
          href="{{ routes.cart_url }}"
          class="hover:opacity-75 transition-opacity relative"
          style="color: var(--equus-header-text);"
          aria-label="Cart">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="absolute -top-2 -right-2 text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center" style="background-color: var(--equus-accent);">{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Mobile Menu Drawer -->
  <div
    x-show="mobileMenuOpen"
    x-cloak
    class="lg:hidden fixed inset-0 z-[1000]">
    <!-- Overlay -->
    <div
      class="fixed inset-0 bg-black/50"
      @click="mobileMenuOpen = false"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"></div>

    <!-- Drawer -->
    <div
      class="fixed inset-y-0 left-0 w-[300px] bg-white shadow-xl overflow-y-auto"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full">

      <!-- Close Button -->
      <button @click="mobileMenuOpen = false" class="flex items-center gap-2 w-full p-5 border-b border-gray-100">
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="font-semibold text-sm">Close</span>
      </button>

      <!-- Mobile Nav Links -->
      <ul class="py-4">
        {% if section.settings.main_menu != blank %}
          {% for link in linklists[section.settings.main_menu].links %}
            <li x-data="{ subOpen: false }" class="border-b border-gray-50">
              <div class="flex items-center justify-between">
                <a href="{{ link.url }}" class="flex-1 px-5 py-4 text-[14px] font-medium text-gray-800">{{ link.title }}</a>
                {% if link.links != blank %}
                  <button @click="subOpen = !subOpen" class="p-4">
                    <svg
                      class="w-4 h-4 text-gray-400 transition-transform"
                      :class="{'rotate-180': subOpen}"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                {% endif %}
              </div>
              {% if link.links != blank %}
                <ul
                  x-show="subOpen"
                  x-collapse
                  class="bg-gray-50 px-5 pb-4">
                  {% for child in link.links %}
                    <li>
                      <a href="{{ child.url }}" class="block py-2 text-[13px] text-gray-600">{{ child.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>

</div>