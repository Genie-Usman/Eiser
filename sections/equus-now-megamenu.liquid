{% schema %}
  {
    "name": "Equus Now Megamenu",
    "settings": [
      {
        "type": "header",
        "content": "Contact Bar"
      },
      {
        "type": "checkbox",
        "id": "show_contact_bar",
        "label": "Show Contact Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "contact_text",
        "label": "Contact Bar Text",
        "default": "CONTACT US 1-740-549-4959"
      },
      {
        "type": "color",
        "id": "contact_bar_bg",
        "label": "Contact Bar Background",
        "default": "#40bfb0"
      }, {
        "type": "color",
        "id": "contact_bar_text",
        "label": "Contact Bar Text Color",
        "default": "#ffffff"
      }, {
        "type": "header",
        "content": "Header Settings"
      }, {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      }, {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 250,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 120
      }, {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main Menu",
        "default": "main-menu",
        "info": "Select your main navigation menu"
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "header_bg",
        "label": "Header Background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "header_text",
        "label": "Header Text Color",
        "default": "#333333"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent Color (Active/Hover)",
        "default": "#40bfb0"
      }, {
        "type": "color",
        "id": "dropdown_bg",
        "label": "Dropdown Background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "sidebar_bg",
        "label": "Left Sidebar Background",
        "default": "#ffffff"
      }, {
        "type": "header",
        "content": "Widths"
      }, {
        "type": "range",
        "id": "sidebar_width",
        "min": 150,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Sidebar Width",
        "default": 210
      }, {
        "type": "range",
        "id": "image_max_width",
        "min": 180,
        "max": 400,
        "step": 10,
        "unit": "px",
        "label": "Image Card Max Width",
        "default": 280
      }
    ],
    "blocks": [
      {
        "type": "sidebar_item",
        "name": "Sidebar",
        "settings": [
          {
            "type": "text",
            "id": "sidebar_title",
            "label": "Sidebar Item Title",
            "info": "Enter a name to identify this block (e.g., Tack and Equipment)"
          },
          {
            "type": "header",
            "content": "Item Identification"
          },
          {
            "type": "text",
            "id": "parent_menu",
            "label": "Parent Menu Title",
            "info": "Exact match, e.g., 'For The Horse'"
          },
          {
            "type": "url",
            "id": "sidebar_url",
            "label": "Sidebar Item URL"
          }, {
            "type": "header",
            "content": "Content Layout"
          }, {
            "type": "select",
            "id": "content_type",
            "label": "Content Type",
            "options": [
              {
                "value": "columns",
                "label": "Text Columns"
              }, {
                "value": "images",
                "label": "Image Cards"
              }, {
                "value": "mixed",
                "label": "Mixed (Columns + Featured Image)"
              }
            ],
            "default": "columns"
          }, {
            "type": "header",
            "content": "Image Settings"
          }, {
            "type": "range",
            "id": "image_card_width",
            "min": 150,
            "max": 500,
            "step": 10,
            "unit": "px",
            "label": "Image Card Width",
            "default": 250,
            "info": "Width of each image card. Height stays fixed."
          }, {
            "type": "header",
            "content": "Column 1"
          }, {
            "type": "text",
            "id": "col1_title",
            "label": "Column 1 Title"
          }, {
            "type": "textarea",
            "id": "col1_links",
            "label": "Column 1 Links",
            "info": "One per line: Link Text|URL"
          }, {
            "type": "header",
            "content": "Column 2"
          }, {
            "type": "text",
            "id": "col2_title",
            "label": "Column 2 Title"
          }, {
            "type": "textarea",
            "id": "col2_links",
            "label": "Column 2 Links"
          }, {
            "type": "header",
            "content": "Column 3"
          }, {
            "type": "text",
            "id": "col3_title",
            "label": "Column 3 Title"
          }, {
            "type": "textarea",
            "id": "col3_links",
            "label": "Column 3 Links"
          }, {
            "type": "header",
            "content": "Column 4"
          }, {
            "type": "text",
            "id": "col4_title",
            "label": "Column 4 Title"
          }, {
            "type": "textarea",
            "id": "col4_links",
            "label": "Column 4 Links"
          }, {
            "type": "header",
            "content": "Column 5"
          }, {
            "type": "text",
            "id": "col5_title",
            "label": "Column 5 Title"
          }, {
            "type": "textarea",
            "id": "col5_links",
            "label": "Column 5 Links"
          }, {
            "type": "header",
            "content": "Image Card 1"
          }, {
            "type": "collection",
            "id": "image1_collection",
            "label": "Collection 1",
            "info": "Select a collection to auto-load its image and title"
          }, {
            "type": "image_picker",
            "id": "image1",
            "label": "Custom Image 1",
            "info": "Overrides the collection image if set"
          }, {
            "type": "text",
            "id": "image1_title",
            "label": "Custom Title 1",
            "info": "Overrides the collection title if set"
          }, {
            "type": "url",
            "id": "image1_url",
            "label": "Image 1 URL"
          }, {
            "type": "header",
            "content": "Image Card 2"
          }, {
            "type": "collection",
            "id": "image2_collection",
            "label": "Collection 2",
            "info": "Select a collection to auto-load its image and title"
          }, {
            "type": "image_picker",
            "id": "image2",
            "label": "Custom Image 2",
            "info": "Overrides the collection image if set"
          }, {
            "type": "text",
            "id": "image2_title",
            "label": "Custom Title 2",
            "info": "Overrides the collection title if set"
          }, {
            "type": "url",
            "id": "image2_url",
            "label": "Image 2 URL"
          }, {
            "type": "header",
            "content": "Image Card 3"
          }, {
            "type": "collection",
            "id": "image3_collection",
            "label": "Collection 3",
            "info": "Select a collection to auto-load its image and title"
          }, {
            "type": "image_picker",
            "id": "image3",
            "label": "Custom Image 3",
            "info": "Overrides the collection image if set"
          }, {
            "type": "text",
            "id": "image3_title",
            "label": "Custom Title 3",
            "info": "Overrides the collection title if set"
          }, {
            "type": "url",
            "id": "image3_url",
            "label": "Image 3 URL"
          }, {
            "type": "header",
            "content": "Image Card 4"
          }, {
            "type": "collection",
            "id": "image4_collection",
            "label": "Collection 4",
            "info": "Select a collection to auto-load its image and title"
          }, {
            "type": "image_picker",
            "id": "image4",
            "label": "Custom Image 4",
            "info": "Overrides the collection image if set"
          }, {
            "type": "text",
            "id": "image4_title",
            "label": "Custom Title 4",
            "info": "Overrides the collection title if set"
          }, {
            "type": "url",
            "id": "image4_url",
            "label": "Image 4 URL"
          }, {
            "type": "header",
            "content": "Featured Image (for Mixed layout)"
          }, {
            "type": "image_picker",
            "id": "featured_image",
            "label": "Featured Image"
          }, {
            "type": "text",
            "id": "featured_title",
            "label": "Featured Image Title"
          }, {
            "type": "url",
            "id": "featured_url",
            "label": "Featured Image URL"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Equus Now Megamenu"
      }
    ]
  }
{% endschema %}

{% style %}
  :root  {
    --equus-header-bg: {{ section.settings.header_bg }};
    --equus-header-text: {{ section.settings.header_text }};
    --equus-accent: {{ section.settings.accent_color }};
    --equus-dropdown-bg: {{ section.settings.dropdown_bg }};
    --equus-sidebar-bg: {{ section.settings.sidebar_bg }};
    --equus-contact-bg: {{ section.settings.contact_bar_bg }};
    --equus-contact-text: {{ section.settings.contact_bar_text }};
    --equus-sidebar-width: {{ section.settings.sidebar_width }}px;
    --equus-image-max-width: {{ section.settings.image_max_width }}px;
  }

  [x-cloak] {
    display: none !important;
  }
{% endstyle %}

<div
  x-data="{ mobileMenuOpen: false }"
  class="w-full relative z-50 font-sans"
  style="font-family: 'Inter', sans-serif;">

  <!-- Contact Bar -->
  {% if section.settings.show_contact_bar %}
    <div class="w-full py-2 text-center text-xs font-semibold tracking-wide" style="background-color: #808080; color: var(--equus-contact-text);">
      {{ section.settings.contact_text }}
    </div>
  {% endif %}

  <!-- Header -->
  <header class="w-full" style="background-color: var(--equus-header-bg);">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-8 h-[70px] flex items-center justify-between">

      <!-- Mobile Toggle -->
      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="lg:hidden p-2 hover:opacity-75"
        aria-label="Toggle Menu">
        <svg
          class="w-6 h-6"
          style="color: var(--equus-header-text);"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="flex items-center shrink-0">
        {% if section.settings.logo != blank %}
          {% assign logo_width_2x = section.settings.logo_width | times: 2 %}
          <img
            src="{{ section.settings.logo | image_url: width: logo_width_2x }}"
            alt="{{ shop.name }}"
            style="width: {{ section.settings.logo_width }}px; max-height: 55px;"
            class="h-auto object-contain"
            loading="eager"
            height="inherit"
            width="inherit">
        {% else %}
          <span class="text-2xl font-extrabold" style="color: var(--equus-header-text);">{{ shop.name }}</span>
        {% endif %}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8 h-full">
        {% if section.settings.main_menu != blank %}
          {% for link in linklists[section.settings.main_menu].links %}
          {% assign link_title_lower = link.title | downcase | strip %}

            {% comment %} Check if this menu item has any sidebar content blocks {% endcomment %}
            {% assign has_content = false %}
            {% for block in section.blocks %}
              {% if block.type == 'sidebar_item' %}
                {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                {% if block_parent == link_title_lower %}
                  {% assign has_content = true %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}

            {% assign show_dropdown = false %}
            {% if link.links != blank or has_content %}
              {% assign show_dropdown = true %}
            {% endif %}

            <div
              class="h-full flex items-center"
              x-data="{ open: false, activeSidebar: '' }"
              @mouseenter="open = true"
              @mouseleave="open = false; activeSidebar = ''">

              <a
                href="{{ link.url }}"
                class="flex items-center gap-1 text-sm font-medium transition-colors duration-200 py-2"
                style="color: var(--equus-header-text);"
                :style="open ? 'color: var(--equus-accent)' : ''"
                {% if show_dropdown %}
                @click.prevent{% endif %}>
                {{ link.title }}
              </a>

              <!-- Megamenu Dropdown -->
              {% if show_dropdown %}
                <div
                  x-show="open"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 translate-y-1"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  x-transition:leave="transition ease-in duration-150"
                  x-cloak
                  class="absolute left-0 top-full w-full bg-white shadow-xl border-t border-gray-100 z-50"
                  style="width: 100vw; left: 50%; transform: translateX(-50%); background-color: var(--equus-dropdown-bg);">

                  <div class="max-w-[1400px] mx-auto flex min-h-[400px]">

                    <!-- Left Sidebar -->
                    <div class="shrink-0 py-4 border-r border-gray-200" style="background-color: ; width: 280px;">
                      {% comment %} Collect unique sidebar items for this parent {% endcomment %}
                      {% comment %} Collect unique sidebar items for this parent {% endcomment %}
                      {% for block in section.blocks %}
                        {% if block.type == 'sidebar_item' %}
                          {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                          {% if block_parent == link_title_lower %}
                            <a
                              href="{{ block.settings.sidebar_url | default: '#' }}"
                              class="flex items-center justify-between px-8 py-2 text-[12px] font-medium"
                              :class="activeSidebar === '{{ block.id }}' ? 'text-(--equus-accent) bg-[#E5E5E5] border-(--equus-accent)' : 'text-gray-700 hover:bg-gray-50 border-transparent'"
                              @mouseenter="activeSidebar = '{{ block.id }}'"
                              {{ block.shopify_attributes }}>
                              {{ block.settings.sidebar_title }}
                              <svg
                                class="w-2.5 h-2.5 opacity-40"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M9 5l7 7-7 7" />
                              </svg>
                            </a>
                          {% endif %}
                        {% endif %}
                      {% endfor %}

                      {% comment %} Fallback: show Shopify menu children {% endcomment %}
                      {% if has_content == false %}
                        {% for child in link.links %}
                          <a href="{{ child.url }}" class="flex items-center justify-between px-6 py-3 text-[13px] font-medium text-gray-700 hover:text-(--equus-accent) hover:bg-white transition-all duration-200">
                            {{ child.title }}
                            <svg
                              class="w-3 h-3 opacity-50"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24">
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7" />
                            </svg>
                          </a>
                        {% endfor %}
                      {% endif %}
                    </div>

                    <!-- Center Content Area -->
                    <div class="flex-1 overflow-hidden">
                      {% comment %} Show content for each sidebar block {% endcomment %}
                      {% for block in section.blocks %}
                        {% if block.type == 'sidebar_item' %}
                          {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                          {% if block_parent == link_title_lower %}
                            <div
                              x-show="activeSidebar === '{{ block.id }}' || (activeSidebar === '' && {{ forloop.first }})"
                              x-transition:enter="transition ease-out duration-150"
                              x-transition:enter-start="opacity-0"
                              x-transition:enter-end="opacity-100"
                              class="h-full">

                              {% case block.settings.content_type %}

                                {% when 'columns' %}
                                  <!-- Text Columns Layout -->
                                  <div class="flex gap-8 py-5 px-6">
                                    {% if block.settings.col1_title != blank %}
                                      <div class="min-w-[140px]">
                                        <h4 class="text-sm font-bold text-gray-800 mb-3">{{ block.settings.col1_title }}</h4>
                                        <ul class="space-y-1.5">
                                          {% assign lines = block.settings.col1_links | newline_to_br | split: '<br />' %}
                                          {% for line in lines %}
                                            {% assign parts = line | split: '|' %}
                                            {% if parts.size >= 2 %}
                                              <li>
                                                <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-(--equus-accent) transition-colors">{{ parts[0] | strip }}</a>
                                              </li>
                                            {% elsif parts[0] != blank %}
                                              <li>
                                                <span class="text-[13px] text-gray-600">{{ parts[0] | strip }}</span>
                                              </li>
                                            {% endif %}
                                          {% endfor %}
                                        </ul>
                                      </div>
                                    {% endif %}

                                    {% if block.settings.col2_title != blank %}
                                      <div class="min-w-[140px]">
                                        <h4 class="text-sm font-bold text-gray-800 mb-3">{{ block.settings.col2_title }}</h4>
                                        <ul class="space-y-1.5">
                                          {% assign lines = block.settings.col2_links | newline_to_br | split: '<br />' %}
                                          {% for line in lines %}
                                            {% assign parts = line | split: '|' %}
                                            {% if parts.size >= 2 %}
                                              <li>
                                                <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-(--equus-accent) transition-colors">{{ parts[0] | strip }}</a>
                                              </li>
                                            {% elsif parts[0] != blank %}
                                              <li>
                                                <span class="text-[13px] text-gray-600">{{ parts[0] | strip }}</span>
                                              </li>
                                            {% endif %}
                                          {% endfor %}
                                        </ul>
                                      </div>
                                    {% endif %}

                                    {% if block.settings.col3_title != blank %}
                                      <div class="min-w-[140px]">
                                        <h4 class="text-sm font-bold text-gray-800 mb-3">{{ block.settings.col3_title }}</h4>
                                        <ul class="space-y-1.5">
                                          {% assign lines = block.settings.col3_links | newline_to_br | split: '<br />' %}
                                          {% for line in lines %}
                                            {% assign parts = line | split: '|' %}
                                            {% if parts.size >= 2 %}
                                              <li>
                                                <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-(--equus-accent) transition-colors">{{ parts[0] | strip }}</a>
                                              </li>
                                            {% elsif parts[0] != blank %}
                                              <li>
                                                <span class="text-[13px] text-gray-600">{{ parts[0] | strip }}</span>
                                              </li>
                                            {% endif %}
                                          {% endfor %}
                                        </ul>
                                      </div>
                                    {% endif %}

                                    {% if block.settings.col4_title != blank %}
                                      <div class="min-w-[140px]">
                                        <h4 class="text-sm font-bold text-gray-800 mb-3">{{ block.settings.col4_title }}</h4>
                                        <ul class="space-y-1.5">
                                          {% assign lines = block.settings.col4_links | newline_to_br | split: '<br />' %}
                                          {% for line in lines %}
                                            {% assign parts = line | split: '|' %}
                                            {% if parts.size >= 2 %}
                                              <li>
                                                <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-(--equus-accent) transition-colors">{{ parts[0] | strip }}</a>
                                              </li>
                                            {% elsif parts[0] != blank %}
                                              <li>
                                                <span class="text-[13px] text-gray-600">{{ parts[0] | strip }}</span>
                                              </li>
                                            {% endif %}
                                          {% endfor %}
                                        </ul>
                                      </div>
                                    {% endif %}

                                    {% if block.settings.col5_title != blank %}
                                      <div class="min-w-[140px]">
                                        <h4 class="text-sm font-bold text-gray-800 mb-3">{{ block.settings.col5_title }}</h4>
                                        <ul class="space-y-1.5">
                                          {% assign lines = block.settings.col5_links | newline_to_br | split: '<br />' %}
                                          {% for line in lines %}
                                            {% assign parts = line | split: '|' %}
                                            {% if parts.size >= 2 %}
                                              <li>
                                                <a href="{{ parts[1] | strip }}" class="text-[13px] text-gray-600 hover:text-(--equus-accent) transition-colors">{{ parts[0] | strip }}</a>
                                              </li>
                                            {% elsif parts[0] != blank %}
                                              <li>
                                                <span class="text-[13px] text-gray-600">{{ parts[0] | strip }}</span>
                                              </li>
                                            {% endif %}
                                          {% endfor %}
                                        </ul>
                                      </div>
                                    {% endif %}
                                  </div>

                                {% when 'images' %}
                                  <!-- Image Cards Layout - Full Width -->
                                  <div class="flex gap-6 h-full py-4 px-6">
                                    {% comment %} Image Card 1 {% endcomment %}
                                    {% assign img1 = block.settings.image1 %}
                                    {% assign img1_title = block.settings.image1_title %}
                                    {% assign img1_url = block.settings.image1_url %}
                                    {% assign col1 = block.settings.image1_collection %}
                                    {% if img1 == blank and col1 != blank %}
                                      {% assign img1 = col1.image %}
                                    {% endif %}
                                    {% if img1_title == blank and col1 != blank %}
                                      {% assign img1_title = col1.title %}
                                    {% endif %}
                                    {% if img1_url == blank and col1 != blank %}
                                      {% assign img1_url = col1.url %}
                                    {% endif %}
                                    {% if img1 != blank %}
                                      <a
                                        href="{{ img1_url | default: '#' }}"
                                        class="flex flex-col group"
                                        style="width: {{ block.settings.image_card_width }}px; flex-shrink: 0;">
                                        <div class="overflow-hidden bg-gray-100 mb-3" style="height: 320px;">
                                          <img
                                            src="{{ img1 | image_url: width: 600 }}"
                                            alt="{{ img1_title }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-full h-full object-cover">
                                        </div>
                                        {% if img1_title != blank %}
                                          <p class="text-sm font-medium text-gray-800 text-center group-hover:text-(--equus-accent)">{{ img1_title }}</p>
                                        {% endif %}
                                      </a>
                                  {% endif %}

                                    {% comment %} Image Card 2 {% endcomment %}
                                    {% assign img2 = block.settings.image2 %}
                                    {% assign img2_title = block.settings.image2_title %}
                                    {% assign img2_url = block.settings.image2_url %}
                                    {% assign col2 = block.settings.image2_collection %}
                                    {% if img2 == blank and col2 != blank %}
                                      {% assign img2 = col2.image %}
                                    {% endif %}
                                    {% if img2_title == blank and col2 != blank %}
                                      {% assign img2_title = col2.title %}
                                    {% endif %}
                                    {% if img2_url == blank and col2 != blank %}
                                      {% assign img2_url = col2.url %}
                                    {% endif %}
                                    {% if img2 != blank %}
                                      <a
                                        href="{{ img2_url | default: '#' }}"
                                        class="flex flex-col group"
                                        style="width: {{ block.settings.image_card_width }}px; flex-shrink: 0;">
                                        <div class="overflow-hidden bg-gray-100 mb-3" style="height: 320px;">
                                          <img
                                            src="{{ img2 | image_url: width: 600 }}"
                                            alt="{{ img2_title }}"
                                            height="inherit"
                                            width="inherit"
                                            class="w-full h-full object-cover">
                                        </div>
                                        {% if img2_title != blank %}
                                          <p class="text-sm font-medium text-gray-800 text-center group-hover:text-(--equus-accent)">{{ img2_title }}</p>
                                        {% endif %}
                                      </a>
                                  {% endif %}

                                    {% comment %} Image Card 3 {% endcomment %}
                                    {% assign img3 = block.settings.image3 %}
                                    {% assign img3_title = block.settings.image3_title %}
                                    {% assign img3_url = block.settings.image3_url %}
                                    {% assign col3 = block.settings.image3_collection %}
                                    {% if img3 == blank and col3 != blank %}
                                      {% assign img3 = col3.image %}
