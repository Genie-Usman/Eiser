  <!-- Mobile Menu Drawer -->
  <div
    x-show="mobileMenuOpen"
    x-cloak
    @keydown.escape.window="mobileMenuOpen = false"
    class="lg:hidden fixed inset-0 z-1000">

    <!-- Overlay -->
    <div
      x-show="mobileMenuOpen"
      x-transition:enter="transition-opacity ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition-opacity ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 bg-black/50"
      @click="mobileMenuOpen = false"></div>

    <!-- Drawer -->
    <div
      x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full"
      class="fixed inset-y-0 left-0 w-[85vw] max-w-[380px] bg-white shadow-xl overflow-y-auto">

      <!-- Close Button -->
      <button @click="mobileMenuOpen = false" class="flex items-center gap-2 w-full px-5 py-4 border-b border-gray-200 hover:bg-gray-50 transition-colors duration-200">
        <svg
          class="w-5 h-5 text-gray-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <nav class="overflow-y-auto">
        {% if section.settings.main_menu != blank %}
          {% for link in linklists[section.settings.main_menu].links %}
          {% assign link_title_lower = link.title | downcase | strip %}

            {% comment %} Check if this menu item has sidebar blocks {% endcomment %}
            {% assign has_blocks = false %}
            {% for block in section.blocks %}
              {% if block.type == 'sidebar_item' %}
                {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                {% if block_parent == link_title_lower %}
                  {% assign has_blocks = true %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}

            {% assign has_children = false %}
            {% if has_blocks or link.links != blank %}
              {% assign has_children = true %}
            {% endif %}

            <!-- Level 1: Main menu item -->
            <div x-data="{ open: false }" class="border-b border-gray-100">
              {% if has_children %}
                <button @click="open = !open" class="w-full flex items-center justify-between px-5 py-3.5 text-left hover:bg-gray-50 transition-colors duration-200">
                  <span class="text-sm font-medium text-gray-800">{{ link.title }}</span>
                  <span class="mobile-toggle-icon text-gray-400" :data-open="open"></span>
                </button>

                <!-- Level 2: Sidebar blocks or Shopify children -->
                <div class="mobile-accordion" :data-open="open">
                  <div class="mobile-accordion-content bg-gray-50">
                    <!-- View All link for parent -->
                    <a href="{{ link.url }}" class="block pl-8 pr-5 py-3 text-sm text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors duration-200">
                      View All
                    </a>

                    {% if has_blocks %}
                      <!-- Sidebar blocks with their column links -->
                      {% for block in section.blocks %}
                        {% if block.type == 'sidebar_item' %}
                          {% assign block_parent = block.settings.parent_menu | downcase | strip %}
                          {% if block_parent == link_title_lower %}
                            {% assign has_col_links = false %}
                            {% if block.settings.col1_links != blank or block.settings.col2_links != blank or block.settings.col3_links != blank or block.settings.col4_links != blank or block.settings.col5_links != blank %}
                              {% assign has_col_links = true %}
                            {% endif %}

                            <div x-data="{ subOpen: false }">
                              {% if has_col_links %}
                                <!-- Expandable block with column links -->
                                <button @click="subOpen = !subOpen" class="w-full flex items-center justify-between pl-8 pr-5 py-3 text-left hover:bg-gray-100 transition-colors duration-200">
                                  <span class="text-sm text-gray-700">{{ block.settings.sidebar_title }}</span>
                                  <span class="mobile-toggle-icon text-gray-400" :data-open="subOpen"></span>
                                </button>

                                <!-- Level 3: Column titles only (Saddles & Fittings, Strap Goods, etc.) -->
                                <div class="mobile-accordion" :data-open="subOpen">
                                  <div class="mobile-accordion-content bg-white">
                                    {% if block.settings.sidebar_url != blank %}
                                      <a href="{{ block.settings.sidebar_url }}" class="block pl-12 pr-5 py-2.5 text-sm text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors duration-200">
                                        View All
                                      </a>
                                    {% endif %}
                                    {% for col_num in (1..5) %}
                                      {% assign col_title_key = 'col' | append: col_num | append: '_title' %}
                                      {% assign col_title = block.settings[col_title_key] %}
                                      {% assign col_links_key = 'col' | append: col_num | append: '_links' %}
                                      {% assign col_links = block.settings[col_links_key] %}
                                      {% if col_title != blank and col_links != blank %}
                                        {% comment %} Get the first link URL to use for the column title {% endcomment %}
                                        {% assign lines = col_links | newline_to_br | split: '<br />' %}
                                        {% assign first_line = lines | first %}
                                        {% assign parts = first_line | split: '|' %}
                                        {% if parts.size >= 2 %}
                                          <a href="{{ parts[1] | strip }}" class="block pl-12 pr-5 py-2.5 text-sm text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors duration-200">
                                            {{ col_title }}
                                          </a>
                                        {% else %}
                                          <span class="block pl-12 pr-5 py-2.5 text-sm text-gray-500">
                                            {{ col_title }}
                                          </span>
                                        {% endif %}
                                      {% endif %}
                                    {% endfor %}
                                  </div>
                                </div>
                              {% else %}
                                <!-- Simple block link -->
                                <a href="{{ block.settings.sidebar_url | default: '#' }}" class="block pl-8 pr-5 py-3 text-sm text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors duration-200">
                                  {{ block.settings.sidebar_title }}
                                </a>
                              {% endif %}
                            </div>
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    {% else %}
                      <!-- Fallback: Shopify menu children -->
                      {% for child in link.links %}
                        <a href="{{ child.url }}" class="block pl-8 pr-5 py-3 text-sm text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors duration-200">
                          {{ child.title }}
                        </a>
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <a href="{{ link.url }}" class="block px-5 py-3.5 text-sm font-medium text-gray-800 hover:bg-gray-50 transition-colors duration-200">
                  {{ link.title }}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </nav>
    </div>
  </div>

</div>