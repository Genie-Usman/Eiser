{% comment %}
  About Us Section - Metaobject Driven
  
  Uses the about_us metaobject with fields:
  - heading: Main section heading (e.g., "Passion For Porsche Since 1978")
  - title: Section title with accent color (e.g., "The Evolution of Auto Atlanta")
  - body: Rich text content
  - image: Section image
{% endcomment %}

<style>
  .about-us-section {
    padding: 60px 0;
    background-color: #1a1a1a;
    color: #ffffff;
  }

  .about-us-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .about-us-page-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 50px;
    color: #ffffff;
  }

  .about-us-card {
    background-color: #2a2a2a;
    border-radius: 4px;
    padding: 40px;
    margin-bottom: 40px;
  }

  .about-us-main-heading {
    text-align: center;
    font-size: 1.75rem;
    font-weight: 500;
    margin-bottom: 40px;
    color: #ffffff;
  }

  .about-us-content-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 40px;
  }

  .about-us-content-block:last-child {
    margin-bottom: 0;
  }

  .about-us-text-content {
    order: 1;
  }

  .about-us-image-content {
    order: 2;
  }

  .about-us-section-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--about-us-accent-color, #a52a2a);
  }

  .about-us-body {
    font-size: 1rem;
    line-height: 1.75;
    color: #cccccc;
  }

  .about-us-body p {
    margin-bottom: 1.25rem;
  }

  .about-us-body p:last-child {
    margin-bottom: 0;
  }

  .about-us-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .about-us-section {
      padding: 40px 0;
    }

    .about-us-page-title {
      font-size: 2rem;
      margin-bottom: 30px;
    }

    .about-us-card {
      padding: 25px;
    }

    .about-us-content-block {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .about-us-text-content {
      order: 1;
    }

    .about-us-image-content {
      order: 2;
    }

    .about-us-section-title {
      font-size: 1.25rem;
    }

    .about-us-body {
      font-size: 0.95rem;
    }
  }
</style>

<section class="about-us-section" style="--about-us-accent-color: {{ section.settings.accent_color }};">
  <div class="about-us-container">
    
    {%- comment -%} Page Title from the page object {%- endcomment -%}
    {% if page.title != blank %}
      <h1 class="about-us-page-title">{{ page.title }}</h1>
    {% endif %}

    <div class="about-us-card">
      {%- comment -%} Main Heading from settings {%- endcomment -%}
      {% if section.settings.main_heading != blank %}
        <h2 class="about-us-main-heading">{{ section.settings.main_heading }}</h2>
      {% endif %}

      {%- comment -%} Content Blocks from Metaobject List {%- endcomment -%}
      {% if section.settings.content_blocks != blank %}
        {% for content in section.settings.content_blocks %}
          <div class="about-us-content-block">
            <div class="about-us-text-content">
              
              {% if content.title != blank %}
                <h3 class="about-us-section-title">{{ content.title.value }}</h3>
              {% endif %}
              
              {% if content.body != blank %}
                <div class="about-us-body">
                  {{ content.body | metafield_tag }}
                </div>
              {% endif %}
            </div>
            
            <div class="about-us-image-content">
              {% if content.image != blank %}
                <img 
                  src="{{ content.image.value | image_url: width: 800 }}"
                  alt="{{ content.title.value | escape }}"
                  class="about-us-image"
                  loading="lazy"
                  width="800"
                  height="600"
                >
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="text-align: center; color: #888;">No content blocks selected. Select your About Us metaobjects in the section settings.</p>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About Us",
  "tag": "section",
  "class": "about-us-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Passion For Excellence Since Day One"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Section Title Color",
      "default": "#a52a2a"
    },
    {
      "type": "metaobject_list",
      "id": "content_blocks",
      "label": "Content Blocks",
      "metaobject_type": "about_us"
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{% endschema %}

